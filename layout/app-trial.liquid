<!doctype html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex,nofollow">
  <title>تجربة تخصيص الاسم — كالابريز</title>
  {{ content_for_header }}
  <style>
    *{box-sizing:border-box}body{margin:0;background:#fff;color:#35291f;font-family:Arial,sans-serif;line-height:1.7}
    .trial-product{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:24px;padding:24px;max-width:1100px;margin:auto}
    .pd-media,.pd-info{min-width:0}.pd-media>img{width:100%;height:auto;display:block;border-radius:12px}
    h1{font-size:22px;margin:0 0 12px}input:not([type=checkbox]):not([type=radio]):not([type=hidden]),select{max-width:100%;font:inherit}
    .trial-approval{display:flex;gap:10px;align-items:flex-start;margin:22px 0}.trial-approval input{margin-top:8px}
    .trial-submit{width:100%;padding:14px;border:0;border-radius:8px;background:#553c29;color:white;font:inherit;cursor:pointer}
    @media(max-width:700px){.trial-product{grid-template-columns:1fr;padding:16px}.pd-media{max-width:480px;margin:auto;width:100%}}
  </style>
</head>
<body>{{ content_for_layout }}</body>
</html>
