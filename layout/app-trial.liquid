<!doctype html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex,nofollow">
  <title>تجربة تخصيص الاسم — كالابريز</title>
  {{ content_for_header }}
  <style>
    *{box-sizing:border-box}body{margin:0;background:#fff;color:#35291f;font-family:Arial,sans-serif;line-height:1.7}
    .trial-product{max-width:760px;margin:auto;padding:16px}
    .trial-head{display:flex;gap:14px;align-items:center;margin-bottom:12px}.trial-thumb{width:84px;height:84px;object-fit:cover;border-radius:10px;flex:none}
    .trial-head h1{font-size:18px;margin:0}.trial-head p{margin:0;color:#6b5a48}
    h1{font-size:22px;margin:0 0 12px}input:not([type=checkbox]):not([type=radio]):not([type=hidden]),select{max-width:100%;font:inherit}
    .trial-approval{display:flex;gap:10px;align-items:flex-start;margin:22px 0 6px}.trial-approval input{margin-top:8px;width:20px;height:20px;flex:none}
    .trial-reset{color:#a23b2a;font-size:14px;margin:0 0 10px}
    .trial-submit{width:100%;padding:14px;border:0;border-radius:8px;background:#553c29;color:white;font:inherit;cursor:pointer}
  </style>
</head>
<body>{{ content_for_layout }}</body>
</html>
