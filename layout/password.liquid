<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#DFD4C3">
<title>{{ settings.brand_name | default: shop.name }} — قريباً</title>
{%- assign calapres_browser_icon = settings.favicon | default: images['calapres-cr-browser-icon-2026-09-08.png'] -%}
{%- if calapres_browser_icon -%}
  {%- assign favicon_16 = calapres_browser_icon | image_url: width: 16, height: 16, crop: 'center' -%}
  {%- assign favicon_32 = calapres_browser_icon | image_url: width: 32, height: 32, crop: 'center' -%}
  {%- assign favicon_180 = calapres_browser_icon | image_url: width: 180, height: 180, crop: 'center' -%}
<link rel="icon" type="image/png" sizes="16x16" href="{{ favicon_16 | append: '&calapres_favicon=cr-seal-20260908' }}">
<link rel="icon" type="image/png" sizes="32x32" href="{{ favicon_32 | append: '&calapres_favicon=cr-seal-20260908' }}">
<link rel="shortcut icon" type="image/png" href="{{ favicon_32 | append: '&calapres_favicon=cr-seal-20260908' }}">
<link rel="apple-touch-icon" sizes="180x180" href="{{ favicon_180 | append: '&calapres_favicon=cr-seal-20260908' }}">
{%- endif -%}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Rubik:wght@300;400;500;700&display=swap" rel="stylesheet">
{{ 'calabriz.css' | asset_url | stylesheet_tag }}
{{ content_for_header }}
</head>
<body>
{{ content_for_layout }}
<script src="{{ 'calabriz.js' | asset_url | append: '&calapres_js=latin-digits-20260901' }}" defer></script>
</body>
</html>
