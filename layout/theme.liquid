<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>
  {%- if template == 'index' -%}{{ settings.brand_name | default: shop.name }} — مباخر فاخرة
  {%- elsif page_title == blank -%}{{ settings.brand_name | default: shop.name }}
  {%- else -%}{{ page_title }} — {{ settings.brand_name | default: shop.name }}{%- endif -%}
</title>
{%- if page_description -%}<meta name="description" content="{{ page_description | escape }}">{%- endif -%}
<link rel="canonical" href="{{ canonical_url }}">
{%- if settings.favicon -%}
<link rel="icon" href="{{ settings.favicon | image_url: width: 32, height: 32 }}" type="image/png">
{%- else -%}
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Ccircle cx='16' cy='16' r='14' fill='%23FFFEF2' stroke='%231B262D' stroke-width='2'/%3E%3Ccircle cx='16' cy='16' r='5' fill='%23A18E63'/%3E%3C/svg%3E">
{%- endif -%}
<meta property="og:site_name" content="{{ shop.name }}">
<meta property="og:url" content="{{ canonical_url }}">
<meta property="og:title" content="{{ page_title | default: shop.name }}">
{%- if page_description -%}<meta property="og:description" content="{{ page_description | escape }}">{%- endif -%}
{%- liquid
  assign social_image = nil
  if request.page_type == 'product'
    assign social_image = product.featured_image
  elsif request.page_type == 'collection'
    assign social_image = collection.image | default: collection.products.first.featured_image
  elsif request.page_type == 'index'
    assign social_image = collections['oud-bakhour'].products.first.featured_image
  endif
-%}
<meta property="og:type" content="{%- if request.page_type == 'product' -%}product{%- else -%}website{%- endif -%}">
{%- if social_image -%}
<meta property="og:image" content="https:{{ social_image | image_url: width: 1200 }}">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="1200">
<meta name="twitter:card" content="summary_large_image">
{%- endif -%}
{% render 'seo-json-ld' %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
{{ 'calabriz.css' | asset_url | stylesheet_tag }}
{{ content_for_header }}
<!-- Calapres theme version: local -->
</head>
<body>

{% section 'header' %}

{{ content_for_layout }}

{% section 'footer' %}

{% render 'cart-drawer' %}

<script src="{{ 'calabriz.js' | asset_url | append: '&calapres_js=20260731a' }}" defer></script>
<script src="{{ 'calabriz-cart.js' | asset_url | append: '&calapres_js=20260731a' }}" defer></script>
</body>
</html>
