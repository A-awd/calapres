{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/A-awd/calapres/n8n/schemas/provider-neutral-llm-response-envelope.schema.json",
  "title": "Provider-neutral bound LLM response envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_ref",
    "request_digest",
    "compiled_context_digest",
    "candidate"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "request_ref": { "type": "string", "pattern": "^lr_[a-f0-9]{64}$" },
    "request_digest": { "$ref": "#/$defs/digest" },
    "compiled_context_digest": { "$ref": "#/$defs/digest" },
    "candidate": { "$ref": "llm-candidate.schema.json" }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  }
}
