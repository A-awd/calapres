{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/A-awd/calapres/n8n/schemas/core-input.schema.json",
  "title": "Optix Customer Service Core v1 input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event",
    "runtime",
    "capabilities",
    "context"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "event": {
      "$ref": "event-envelope.schema.json"
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "customer_egress_enabled",
        "kill_switch"
      ],
      "properties": {
        "mode": {
          "const": "observation"
        },
        "customer_egress_enabled": {
          "const": false
        },
        "kill_switch": {
          "type": "boolean"
        }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "customer_lookup",
        "order_lookup"
      ],
      "properties": {
        "customer_lookup": {
          "enum": [
            "disabled",
            "enabled"
          ]
        },
        "order_lookup": {
          "enum": [
            "disabled",
            "enabled"
          ]
        }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "knowledge_version",
        "knowledge_facts",
        "live_facts_status",
        "verified_live_facts"
      ],
      "properties": {
        "knowledge_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "knowledge_facts": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "knowledge_id",
              "authority",
              "response_text"
            ],
            "properties": {
              "knowledge_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9._:-]{2,120}$"
              },
              "authority": {
                "enum": [
                  "draft_only",
                  "owner_required",
                  "mandatory_stop"
                ]
              },
              "response_text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1200
              }
            }
          }
        },
        "live_facts_status": {
          "enum": [
            "not_requested",
            "verified",
            "unavailable",
            "ambiguous"
          ]
        },
        "verified_live_facts": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "live_fact_id",
              "response_text"
            ],
            "properties": {
              "live_fact_id": {
                "type": "string",
                "pattern": "^lf_[A-Za-z0-9._:-]{3,120}$"
              },
              "response_text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1200
              }
            }
          }
        }
      }
    },
    "candidate": {
      "$ref": "llm-candidate.schema.json"
    }
  }
}
