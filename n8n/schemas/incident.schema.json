{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/A-awd/calapres/n8n/schemas/incident.schema.json",
  "title": "Calapres sanitized customer-service incident",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "brand_id",
    "incident_id",
    "correlation_id",
    "conversation_ref",
    "order_ref",
    "severity",
    "category",
    "reason_code",
    "sanitized_summary",
    "status",
    "draft_ref",
    "owner_decision_ref",
    "created_at",
    "updated_at",
    "resolved_at"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "brand_id": {
      "const": "calapres"
    },
    "incident_id": {
      "type": "string",
      "pattern": "^inc_[A-Za-z0-9_-]{8,80}$"
    },
    "correlation_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128
    },
    "conversation_ref": {
      "type": "string",
      "pattern": "^cwr_[A-Za-z0-9_-]{6,128}$"
    },
    "order_ref": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^sho_[A-Za-z0-9_-]{6,128}$"
    },
    "severity": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "category": {
      "enum": [
        "knowledge_gap",
        "identity_ambiguity",
        "customer_complaint",
        "return_or_refund",
        "order_change",
        "payment_dispute",
        "privacy",
        "legal",
        "security",
        "connector_failure",
        "schema_failure",
        "rate_limit",
        "other"
      ]
    },
    "reason_code": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{2,80}$"
    },
    "sanitized_summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "description": "No names, contact details, addresses, message bodies, or order payloads."
    },
    "status": {
      "enum": [
        "open",
        "awaiting_owner",
        "resolved",
        "dismissed"
      ]
    },
    "draft_ref": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^dft_[A-Za-z0-9_-]{6,128}$"
    },
    "owner_decision_ref": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^dec_[A-Za-z0-9_-]{8,80}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "resolved_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "resolved"
          }
        }
      },
      "then": {
        "properties": {
          "resolved_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  ]
}
