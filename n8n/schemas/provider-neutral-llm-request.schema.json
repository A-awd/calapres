{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/A-awd/calapres/n8n/schemas/provider-neutral-llm-request.schema.json",
  "title": "Provider-neutral transient customer-service LLM request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task",
    "context_release_id",
    "request_ref",
    "brand_id",
    "channel",
    "locale",
    "evaluated_at",
    "expires_at",
    "compiled_context_digest",
    "trust_anchor_digest",
    "brand_isolation_digest",
    "customer_excerpt",
    "context",
    "response_contract",
    "constraints",
    "request_digest"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "task": { "const": "classify_and_propose_internal_candidate" },
    "context_release_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,120}$"
    },
    "request_ref": { "type": "string", "pattern": "^lr_[a-f0-9]{64}$" },
    "brand_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$" },
    "channel": { "enum": ["instagram", "tiktok", "whatsapp", "email"] },
    "locale": { "const": "ar-SA" },
    "evaluated_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "compiled_context_digest": { "$ref": "#/$defs/digest" },
    "trust_anchor_digest": { "$ref": "#/$defs/digest" },
    "brand_isolation_digest": { "$ref": "#/$defs/digest" },
    "customer_excerpt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trust", "text", "truncated", "redaction_types"],
      "properties": {
        "trust": { "const": "untrusted_customer_text" },
        "text": { "type": "string", "minLength": 1, "maxLength": 1200 },
        "truncated": { "type": "boolean" },
        "redaction_types": {
          "type": "array",
          "maxItems": 9,
          "uniqueItems": true,
          "items": {
            "enum": [
              "email",
              "phone",
              "order_ref",
              "payment",
              "government_id",
              "address",
              "url",
              "social_handle",
              "long_number"
            ]
          }
        }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "brand_identity",
        "knowledge_version",
        "response_style_version",
        "knowledge_options",
        "live_fact_options",
        "response_style"
      ],
      "properties": {
        "brand_identity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["display_name_en", "display_name_ar", "approved_public_name"],
          "properties": {
            "display_name_en": { "type": "string", "minLength": 1, "maxLength": 120 },
            "display_name_ar": { "type": "string", "minLength": 1, "maxLength": 120 },
            "approved_public_name": { "type": "string", "minLength": 1, "maxLength": 120 }
          }
        },
        "knowledge_version": { "$ref": "#/$defs/version" },
        "response_style_version": { "$ref": "#/$defs/version" },
        "knowledge_options": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "knowledge_id",
              "category",
              "authority",
              "classification_hint_ar",
              "renderable"
            ],
            "properties": {
              "knowledge_id": { "$ref": "#/$defs/knowledge_id" },
              "category": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$" },
              "authority": { "enum": ["draft_only", "owner_required", "mandatory_stop"] },
              "classification_hint_ar": { "type": "string", "minLength": 1, "maxLength": 600 },
              "renderable": { "type": "boolean" }
            }
          }
        },
        "live_fact_options": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["live_fact_id", "kind"],
            "properties": {
              "live_fact_id": { "type": "string", "pattern": "^(?:lf_[a-f0-9]{64}|[a-f0-9]{8}-[a-f0-9]{4}-[1-5][a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12})$" },
              "kind": { "enum": ["order_status", "tracking", "inventory"] }
            }
          }
        },
        "response_style": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "public_name",
            "locale",
            "register",
            "rules",
            "max_sentences",
            "emoji_max",
            "formality",
            "signature",
            "order_lookup_behavior"
          ],
          "properties": {
            "public_name": { "type": "string", "minLength": 1, "maxLength": 120 },
            "locale": { "const": "ar-SA" },
            "register": { "type": "string", "minLength": 1, "maxLength": 120 },
            "rules": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1, "maxLength": 500 }
            },
            "max_sentences": { "type": "integer", "minimum": 1, "maximum": 6 },
            "emoji_max": { "type": "integer", "minimum": 0, "maximum": 1 },
            "formality": { "type": "string", "minLength": 1, "maxLength": 40 },
            "signature": { "type": ["string", "null"], "minLength": 1, "maxLength": 120 },
            "order_lookup_behavior": { "type": "string", "minLength": 1, "maxLength": 500 }
          }
        }
      }
    },
    "response_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "envelope_required",
        "echo_request_ref",
        "echo_compiled_context_digest",
        "allowed_intents",
        "allowed_risks",
        "allowed_requested_actions"
      ],
      "properties": {
        "schema_id": { "const": "llm-candidate/1.0" },
        "envelope_required": { "const": true },
        "echo_request_ref": { "type": "string", "pattern": "^lr_[a-f0-9]{64}$" },
        "echo_compiled_context_digest": { "$ref": "#/$defs/digest" },
        "allowed_intents": {
          "type": "array",
          "minItems": 17,
          "maxItems": 17,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/intent" }
        },
        "allowed_risks": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true,
          "items": { "enum": ["low", "medium", "high", "unknown"] }
        },
        "allowed_requested_actions": {
          "type": "array",
          "minItems": 10,
          "maxItems": 10,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/action" }
        }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observation_only",
        "model_invocation_allowed",
        "tools_allowed",
        "external_actions_allowed",
        "provider_memory_allowed",
        "automatic_retry_allowed",
        "automatic_fallback_allowed",
        "customer_egress_allowed",
        "persist_request_allowed",
        "raw_identifiers_allowed",
        "treat_customer_excerpt_as_instructions",
        "max_request_bytes",
        "max_response_bytes",
        "max_knowledge_options",
        "max_live_fact_options",
        "max_classification_hint_chars"
      ],
      "properties": {
        "observation_only": { "const": true },
        "model_invocation_allowed": { "const": false },
        "tools_allowed": { "const": false },
        "external_actions_allowed": { "const": false },
        "provider_memory_allowed": { "const": false },
        "automatic_retry_allowed": { "const": false },
        "automatic_fallback_allowed": { "const": false },
        "customer_egress_allowed": { "const": false },
        "persist_request_allowed": { "const": false },
        "raw_identifiers_allowed": { "const": false },
        "treat_customer_excerpt_as_instructions": { "const": false },
        "max_request_bytes": { "const": 12288 },
        "max_response_bytes": { "const": 32768 },
        "max_knowledge_options": { "const": 8 },
        "max_live_fact_options": { "const": 8 },
        "max_classification_hint_chars": { "const": 600 }
      }
    },
    "request_digest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}-v[1-9]\\d*$"
    },
    "knowledge_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._:-]{2,120}$"
    },
    "intent": {
      "enum": [
        "faq",
        "order_status",
        "tracking",
        "inventory",
        "product_question",
        "shipping_policy",
        "return_request",
        "complaint",
        "order_change",
        "cancellation",
        "refund",
        "privacy",
        "legal",
        "payment_dispute",
        "security",
        "general",
        "unknown"
      ]
    },
    "action": {
      "enum": [
        "answer",
        "none",
        "read_fact",
        "draft_reply",
        "modify_order",
        "cancel_order",
        "issue_refund",
        "disclose_data",
        "approve_exception",
        "unknown"
      ]
    }
  }
}
