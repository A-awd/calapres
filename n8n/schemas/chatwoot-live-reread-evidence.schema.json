  "properties": {
    "schema_version": { "const": "1.0" },
    "kind": { "const": "chatwoot_live_reread_v1" },
    "source": { "const": "chatwoot_live_api_topology" },
    "evidence_id": { "type": "string", "pattern": "^cwr_[A-Za-z0-9_-]{8,80}$" },
    "brand_id": { "const": "calapres" },
    "account_id": { "const": 179973 },
    "inbox_id": { "enum": [128031, 128033, 128058, 128326] },
    "channel": { "enum": ["instagram", "tiktok", "whatsapp", "email"] },
    "conversation_id": { "type": "string", "pattern": "^[1-9][0-9]{0,15}$" },
    "anchor_message_id": {
      "$comment": "Live mode requires a canonical positive-integer Chatwoot Message id rendered as a decimal string.",
      "type": "string",
      "pattern": "^[1-9][0-9]{0,15}$"
    },
    "anchor_message_ordering_id": {
      "$comment": "Must be the strict integer normalization of anchor_message_id and is used instead of created_at for same-second ordering.",
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "generation": { "type": "integer", "minimum": 1 },
    "wait_state_fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "event_identity_key_version": {
      "type": "string",
      "pattern": "^(synthetic-event-identity-v[1-9][0-9]*|calapres-identity-hmac-v[1-9][0-9]*)$"
    },
    "event_identity_fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "event_identity_anchor_verified": {
      "$comment": "Topology recomputes the brand-keyed event identity from the exact account/inbox/conversation/anchor route under the pinned key version and compares it to the Wait fingerprint.",
      "type": ["boolean", "null"]
    },
    "not_before": { "type": "string", "format": "date-time" },
    "read_started_at": { "type": "string", "format": "date-time" },
    "checked_at": { "type": "string", "format": "date-time" },
    "live_read_status": {
      "enum": [
        "verified",
        "route_mismatch",
        "unauthorized",
        "forbidden",
        "not_found",
        "rate_limited",
        "unavailable",
        "schema_invalid",
        "scan_truncated",
        "scan_changed",
        "anchor_missing",
        "conversation_changed"
      ]
    },
    "http_status": { "type": ["integer", "null"], "minimum": 100, "maximum": 599 },
    "source_verified": { "type": "boolean" },
    "route_verified": { "type": "boolean" },
    "response_fingerprint": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "anchor_message_fingerprint": {
      "$comment": "Verified evidence must equal delayed-observation-state.message_fingerprint and both bounded-scan anchor fingerprints. That fingerprint is the brand-keyed HMAC over the exact route, numeric anchor id, inbound direction, public visibility, and pinned event identity.",
      "type": ["string", "null"],
      "pattern": "^[a-f0-9]{64}$"
    },
    "anchor_message_type": {
      "$comment": "Chatwoot incoming customer message type. Any outgoing, private, or activity anchor fails closed.",
      "type": ["integer", "null"],
      "enum": [0, null]
    },
    "anchor_private": { "type": ["boolean", "null"] },
    "anchor_message_created_at": { "type": ["string", "null"], "format": "date-time" },
    "anchor_message_created_at_source": {
      "type": ["string", "null"],
      "enum": ["chatwoot_message.created_at_unix_seconds", null]
    },
    "latest_inbound_fingerprint": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "latest_inbound_created_at": { "type": ["string", "null"], "format": "date-time" },
    "latest_inbound_created_at_source": {
      "type": ["string", "null"],
      "enum": ["chatwoot_message.created_at_unix_seconds", null]
    },
    "latest_inbound_ordering_id": { "type": ["integer", "null"], "minimum": 1, "maximum": 9007199254740991 },
    "latest_public_human_reply_fingerprint": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "latest_public_human_reply_created_at": { "type": ["string", "null"], "format": "date-time" },
    "latest_public_human_reply_created_at_source": {
      "type": ["string", "null"],
      "enum": ["chatwoot_message.created_at_unix_seconds", null]
    },
    "latest_public_human_reply_ordering_id": { "type": ["integer", "null"], "minimum": 1, "maximum": 9007199254740991 },
    "latest_private_note_fingerprint": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "latest_private_note_created_at": { "type": ["string", "null"], "format": "date-time" },
    "latest_private_note_created_at_source": {
      "type": ["string", "null"],
      "enum": ["chatwoot_message.created_at_unix_seconds", null]
    },
    "latest_private_note_ordering_id": { "type": ["integer", "null"], "minimum": 1, "maximum": 9007199254740991 },
    "latest_non_activity_fingerprint": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "latest_non_activity_created_at": { "type": ["string", "null"], "format": "date-time" },
    "latest_non_activity_created_at_source": {
      "type": ["string", "null"],
      "enum": ["chatwoot_message.created_at_unix_seconds", null]
    },
    "latest_non_activity_ordering_id": { "type": ["integer", "null"], "minimum": 1, "maximum": 9007199254740991 },
    "scan_strategy": {
      "$comment": "Two independent GET messages reads use after=anchor_message_ordering_id-1. Each must contain fewer than 100 messages, include the exact anchor, and yield the same SHA-256 fingerprint of canonical sorted [message_id,message_fingerprint] pairs. No arbitrary pagination-complete claim is made.",
      "const": "chatwoot_double_bounded_after_anchor_minus_one_v1"
    },
    "scan_page_size_limit": { "const": 100 },
    "scan_after_id": { "type": ["integer", "null"], "minimum": 0, "maximum": 9007199254740990 },
    "scan_first_count": {
      "$comment": "Exact unfiltered Chatwoot response payload length. Count is taken before any row validation; 100 is truncated and fails closed.",
      "type": ["integer", "null"], "minimum": 1, "maximum": 100
    },
    "scan_second_count": {
      "$comment": "Exact unfiltered Chatwoot response payload length. Count is taken before any row validation; 100 is truncated and fails closed.",
      "type": ["integer", "null"], "minimum": 1, "maximum": 100
    },
    "scan_first_all_rows_valid": { "type": ["boolean", "null"] },
    "scan_second_all_rows_valid": { "type": ["boolean", "null"] },
    "scan_first_set_fingerprint": {
      "$comment": "Snapshot-only SHA-256, not an authentication token: UTF-8 minified JSON array of [positive_safe_integer_message_id,message_fingerprint] pairs sorted by numeric ID. It is transient and only compared exactly to the independently read second set.",
      "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"
    },
    "scan_second_set_fingerprint": {
      "$comment": "Same canonical snapshot-only SHA-256 construction as scan_first_set_fingerprint; exact equality is mandatory.",
      "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"
    },
    "scan_sets_equal": { "type": ["boolean", "null"] },
    "scan_anchor_present_first": { "type": ["boolean", "null"] },
    "scan_anchor_present_second": { "type": ["boolean", "null"] },
    "scan_anchor_fingerprint_first": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "scan_anchor_fingerprint_second": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "scan_highest_message_id": { "type": ["integer", "null"], "minimum": 1, "maximum": 9007199254740991 },
    "scan_highest_non_activity_id": {
      "$comment": "Maximum numeric id among message_type 0/1 rows in the validated bounded scan; it must equal latest_non_activity_ordering_id and is never taken from Conversation Details.",
      "type": ["integer", "null"],
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "scan_complete": { "type": ["boolean", "null"] },
    "conversation_before_route_verified": { "type": ["boolean", "null"] },
    "conversation_after_route_verified": { "type": ["boolean", "null"] },
    "conversation_before_status_fingerprint": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "conversation_after_status_fingerprint": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "conversation_before_assignee_fingerprint": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "conversation_after_assignee_fingerprint": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "conversation_snapshots_stable": { "type": ["boolean", "null"] },
    "baseline_fingerprint_key_version": {
      "type": "string",
      "pattern": "^(synthetic-v[1-9][0-9]*|calapres-hmac-v[1-9][0-9]*)$"
    },
    "baseline_status_fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "current_status_fingerprint": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "baseline_assignee_fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "current_assignee_fingerprint": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "anchor_message_present": { "type": ["boolean", "null"] },
    "anchor_is_latest_inbound": { "type": ["boolean", "null"] },
    "newer_inbound_present": { "type": ["boolean", "null"] },
    "public_human_reply_present": { "type": ["boolean", "null"] },
    "private_note_present": { "type": ["boolean", "null"] },
    "newer_non_activity_present": { "type": ["boolean", "null"] },
    "status_changed": { "type": ["boolean", "null"] },
    "assignee_changed": { "type": ["boolean", "null"] },
    "transient_only": { "const": true },
    "persistence_allowed": { "const": false },
    "wait_payload_allowed": { "const": false },
    "data_table_payload_allowed": { "const": false },
    "audit_payload_allowed": { "const": false },
    "customer_egress_allowed": { "const": false }
  },
  "allOf": [
    {
      "if": { "properties": { "channel": { "const": "instagram" } }, "required": ["channel"] },
      "then": { "properties": { "inbox_id": { "const": 128031 } } }
