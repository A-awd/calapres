{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/A-awd/calapres/n8n/schemas/chatwoot-reconciliation-messages-page.schema.json",
  "title": "Calapres sanitized Chatwoot messages-after reconciliation page",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "status",
    "reason_code",
    "source",
    "brand_id",
    "account_id",
    "inbox_id",
    "channel",
    "conversation_id",
    "requested_after_message_id",
    "proposed_next_after_message_id",
    "page_row_count",
    "page_full",
    "continue_required_after_commit",
    "event_candidates",
    "deterministic_exclusions",
    "outcome_requirements",
    "activation_floor_at",
    "activation_policy_version",
    "incident_required",
    "manual_resolution_required",
    "cursor_advance_ready",
    "api_retry_required",
    "customer_egress_allowed",
    "page_binding_sha256"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "kind": { "const": "chatwoot_reconciliation_messages_page_v1" },
    "status": { "enum": ["ready", "incomplete"] },
    "reason_code": { "type": ["string", "null"], "enum": [null, "scan_truncated"] },
    "source": { "const": "chatwoot_reconciliation_v1" },
    "brand_id": { "const": "calapres" },
    "account_id": { "const": 179973 },
    "inbox_id": { "enum": [128031, 128033, 128058, 128326] },
    "channel": { "enum": ["instagram", "tiktok", "whatsapp", "email"] },
    "conversation_id": { "type": "string", "pattern": "^[1-9][0-9]{0,30}$" },
    "requested_after_message_id": { "type": "integer", "minimum": 0 },
    "proposed_next_after_message_id": { "type": ["integer", "null"], "minimum": 0 },
    "page_row_count": { "type": "integer", "minimum": 0, "maximum": 100 },
    "page_full": { "type": "boolean" },
    "continue_required_after_commit": { "type": "boolean" },
    "event_candidates": {
      "type": "array",
      "maxItems": 99,
      "items": { "$ref": "chatwoot-reconciliation-event-candidate.schema.json" }
    },
    "deterministic_exclusions": {
      "type": "array",
      "maxItems": 99,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["message_id", "reason_code", "activation_policy_version"],
        "properties": {
          "message_id": { "type": "string", "pattern": "^[1-9][0-9]{0,15}$" },
          "reason_code": {
            "enum": [
              "before_activation_floor",
              "private_message",
              "outgoing_message",
              "activity_message",
              "template_message",
              "bot_echo"
            ]
          },
          "activation_policy_version": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}-v[1-9][0-9]*$"
          }
        }
      }
    },
    "outcome_requirements": {
      "type": "array",
      "maxItems": 99,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "message_id",
          "classification",
          "required_reason_code",
          "created_at",
          "message_type",
          "private",
          "sender_type",
          "allowed_outcomes"
        ],
        "properties": {
          "message_id": { "type": "string", "pattern": "^[1-9][0-9]{0,15}$" },
          "classification": { "enum": ["event_candidate", "deterministically_excluded"] },
          "required_reason_code": {
            "type": ["string", "null"],
            "pattern": "^[a-z][a-z0-9_]{2,80}$"
          },
          "created_at": {
            "type": ["integer", "null"],
            "minimum": 0,
            "maximum": 253402300799
          },
          "message_type": {
            "type": ["integer", "null"],
            "enum": [null, 0, 1, 2, 3]
          },
          "private": { "type": ["boolean", "null"] },
          "sender_type": {
            "type": ["string", "null"],
            "enum": [null, "contact", "user", "agent", "agent_bot", "bot"]
          },
          "allowed_outcomes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2,
            "uniqueItems": true,
            "items": {
              "enum": ["durable_bound", "durable_duplicate", "deterministically_excluded"]
            }
          }
        }
      }
    },
    "activation_floor_at": { "type": "string", "format": "date-time" },
    "activation_policy_version": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}-v[1-9][0-9]*$"
    },
    "incident_required": { "type": "boolean" },
    "manual_resolution_required": { "type": "boolean" },
    "cursor_advance_ready": { "const": false },
    "api_retry_required": { "type": "boolean" },
    "customer_egress_allowed": { "const": false },
    "page_binding_sha256": {
      "type": ["string", "null"],
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "ready" } } },
      "then": {
        "properties": {
          "reason_code": { "const": null },
          "proposed_next_after_message_id": { "type": "integer" },
          "page_row_count": { "maximum": 99 },
          "page_full": { "const": false },
          "continue_required_after_commit": { "const": false },
          "incident_required": { "const": false },
          "manual_resolution_required": { "const": false },
          "api_retry_required": { "const": false },
          "page_binding_sha256": { "type": "string" }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "incomplete" } } },
      "then": {
        "properties": {
          "reason_code": { "const": "scan_truncated" },
          "proposed_next_after_message_id": { "const": null },
          "page_row_count": { "const": 100 },
          "page_full": { "const": true },
          "continue_required_after_commit": { "const": false },
          "event_candidates": { "maxItems": 0 },
          "deterministic_exclusions": { "maxItems": 0 },
          "outcome_requirements": { "maxItems": 0 },
          "incident_required": { "const": true },
          "manual_resolution_required": { "const": true },
          "api_retry_required": { "const": true },
          "page_binding_sha256": { "const": null }
        }
      }
    }
  ]
}
