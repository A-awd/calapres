{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/A-awd/calapres/n8n/schemas/customer-links-table-row-v2.schema.json",
  "title": "Target exact flattened Calapres customer_links row with brand and key version",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "brand_id",
    "link_id",
    "channel",
    "inbox_id",
    "channel_identity_fingerprint",
    "fingerprint_key_version",
    "chatwoot_contact_id",
    "shopify_customer_gid",
    "order_gid_scope",
    "verification_method",
    "assurance_level",
    "verified_at",
    "expires_at",
    "revoked_at"
  ],
  "properties": {
    "brand_id": { "const": "calapres" },
    "link_id": { "type": "string", "pattern": "^idl_[A-Za-z0-9_-]{8,80}$" },
    "channel": { "enum": ["instagram", "tiktok", "whatsapp", "email"] },
    "inbox_id": { "type": "string", "pattern": "^[1-9][0-9]{0,30}$" },
    "channel_identity_fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "fingerprint_key_version": { "type": "string", "pattern": "^hmac-sha256-v[1-9][0-9]*$" },
    "chatwoot_contact_id": { "type": "string", "pattern": "^[1-9][0-9]{0,30}$" },
    "shopify_customer_gid": {
      "type": ["string", "null"],
      "pattern": "^gid://shopify/Customer/[1-9][0-9]{0,30}$"
    },
    "order_gid_scope": {
      "type": ["string", "null"],
      "pattern": "^gid://shopify/Order/[1-9][0-9]{0,30}$"
    },
    "verification_method": {
      "enum": ["exact_channel", "owner_confirmed", "shopify_verified"]
    },
    "assurance_level": { "enum": ["verified", "revoked"] },
    "verified_at": { "type": ["string", "null"], "format": "date-time" },
    "expires_at": { "type": ["string", "null"], "format": "date-time" },
    "revoked_at": { "type": ["string", "null"], "format": "date-time" }
  },
  "allOf": [
    {
      "if": { "properties": { "assurance_level": { "const": "verified" } } },
      "then": {
        "properties": {
          "verified_at": { "type": "string", "format": "date-time" },
          "revoked_at": { "type": "null" }
        }
      }
    },
    {
      "if": { "properties": { "assurance_level": { "const": "revoked" } } },
      "then": {
        "properties": {
          "revoked_at": { "type": "string", "format": "date-time" }
        }
      }
    }
  ]
}
