{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/A-awd/calapres/n8n/schemas/chatwoot-reconciliation-event-candidate.schema.json",
  "title": "Calapres transient Chatwoot reconciliation event candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "source",
    "brand_id",
    "account_id",
    "inbox_id",
    "channel",
    "event",
    "conversation_id",
    "message_id",
    "event_at",
    "direction",
    "visibility",
    "sender_class",
    "attachment_count",
    "canonical_tuple_format",
    "canonical_tuple",
    "active_event_identity_key_version",
    "retained_event_identity_key_versions",
    "event_identity_hmac_requests",
    "activation_floor_at",
    "activation_policy_version",
    "content_state",
    "live_reread_required",
    "raw_content_used",
    "raw_contact_used",
    "transient_only",
    "persistence_allowed",
    "wait_payload_allowed",
    "audit_payload_allowed",
    "customer_egress_allowed",
    "candidate_ref",
    "candidate_binding_sha256"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "kind": { "const": "chatwoot_reconciliation_event_candidate_v1" },
    "source": { "const": "chatwoot_reconciliation_v1" },
    "brand_id": { "const": "calapres" },
    "account_id": { "const": 179973 },
    "inbox_id": { "enum": [128031, 128033, 128058, 128326] },
    "channel": { "enum": ["instagram", "tiktok", "whatsapp", "email"] },
    "event": { "const": "message_created" },
    "conversation_id": { "type": "string", "pattern": "^[1-9][0-9]{0,30}$" },
    "message_id": { "type": "string", "pattern": "^[1-9][0-9]{0,15}$" },
    "event_at": { "type": "string", "format": "date-time" },
    "direction": { "const": "incoming" },
    "visibility": { "const": "public" },
    "sender_class": { "const": "contact" },
    "attachment_count": { "type": "integer", "minimum": 0, "maximum": 32 },
    "canonical_tuple_format": {
      "const": "json-minified-ordered:[schema_version,account_id,inbox_id,event,conversation_id,message_id]"
    },
    "canonical_tuple": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "account_id",
        "inbox_id",
        "event",
        "conversation_id",
        "message_id"
      ],
      "properties": {
        "schema_version": { "const": "1.0" },
        "account_id": { "const": 179973 },
        "inbox_id": { "enum": [128031, 128033, 128058, 128326] },
        "event": { "const": "message_created" },
        "conversation_id": { "type": "string", "pattern": "^[1-9][0-9]{0,30}$" },
        "message_id": { "type": "string", "pattern": "^[1-9][0-9]{0,15}$" }
      }
    },
    "active_event_identity_key_version": {
      "type": "string",
      "pattern": "^calapres-identity-hmac-v[1-9][0-9]*$"
    },
    "retained_event_identity_key_versions": {
      "type": "array",
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^calapres-identity-hmac-v[1-9][0-9]*$"
      }
    },
    "event_identity_hmac_requests": {
      "type": "array",
      "minItems": 1,
      "maxItems": 9,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["purpose", "key_version", "algorithm", "encoding", "material_utf8"],
        "properties": {
          "purpose": { "const": "event_identity" },
          "key_version": {
            "type": "string",
            "pattern": "^calapres-identity-hmac-v[1-9][0-9]*$"
          },
          "algorithm": { "const": "hmac-sha256" },
          "encoding": { "const": "hex" },
          "material_utf8": { "type": "string", "minLength": 80, "maxLength": 512 }
        }
      }
    },
    "activation_floor_at": { "type": "string", "format": "date-time" },
    "activation_policy_version": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}-v[1-9][0-9]*$"
    },
    "content_state": { "const": "deferred_live_reread" },
    "live_reread_required": { "const": true },
    "raw_content_used": { "const": false },
    "raw_contact_used": { "const": false },
    "transient_only": { "const": true },
    "persistence_allowed": { "const": false },
    "wait_payload_allowed": { "const": false },
    "audit_payload_allowed": { "const": false },
    "customer_egress_allowed": { "const": false },
    "candidate_ref": { "type": "string", "pattern": "^cwr_[a-f0-9]{24}$" },
    "candidate_binding_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
