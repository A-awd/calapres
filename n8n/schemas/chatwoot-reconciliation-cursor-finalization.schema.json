{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/A-awd/calapres/n8n/schemas/chatwoot-reconciliation-cursor-finalization.schema.json",
  "title": "Calapres Chatwoot reconciliation cursor finalization",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "status",
    "reason_code",
    "source",
    "brand_id",
    "account_id",
    "inbox_id",
    "channel",
    "conversation_id",
    "expected_after_message_id",
    "new_after_message_id",
    "activation_floor_at",
    "activation_policy_version",
    "proof_rows",
    "page_binding_sha256",
    "outcome_digest",
    "row_count",
    "cursor_advance_ready",
    "continue_required",
    "no_loss_claimed",
    "customer_egress_allowed"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "kind": { "const": "chatwoot_reconciliation_cursor_finalization_v1" },
    "status": { "const": "ready" },
    "reason_code": { "const": null },
    "source": { "const": "chatwoot_reconciliation_v1" },
    "brand_id": { "const": "calapres" },
    "account_id": { "const": 179973 },
    "inbox_id": { "enum": [128031, 128033, 128058, 128326] },
    "channel": { "enum": ["instagram", "tiktok", "whatsapp", "email"] },
    "conversation_id": { "type": "string", "pattern": "^[1-9][0-9]{0,30}$" },
    "expected_after_message_id": { "type": "integer", "minimum": 0 },
    "new_after_message_id": { "type": "integer", "minimum": 1 },
    "activation_floor_at": { "type": "string", "format": "date-time" },
    "activation_policy_version": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}-v[1-9][0-9]*$"
    },
    "proof_rows": {
      "type": "array",
      "minItems": 1,
      "maxItems": 99,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/proofRow" }
    },
    "page_binding_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "outcome_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "row_count": { "type": "integer", "minimum": 1, "maximum": 99 },
    "cursor_advance_ready": { "const": true },
    "continue_required": { "const": false },
    "no_loss_claimed": { "const": false },
    "customer_egress_allowed": { "const": false }
  },
  "$defs": {
    "proofRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "message_id",
        "classification",
        "outcome",
        "reason_code",
        "created_at",
        "message_type",
        "private",
        "sender_type",
        "event_identity_key_version",
        "event_identity_fingerprint",
        "business_claim_id",
        "job_id",
        "generation"
      ],
      "properties": {
        "message_id": { "type": "string", "pattern": "^[1-9][0-9]{0,15}$" },
        "classification": {
          "enum": ["event_candidate", "deterministically_excluded"]
        },
        "outcome": {
          "enum": ["durable_bound", "durable_duplicate", "deterministically_excluded"]
        },
        "reason_code": {
          "type": ["string", "null"],
          "enum": [
            null,
            "before_activation_floor",
            "private_message",
            "outgoing_message",
            "activity_message",
            "template_message",
            "bot_echo"
          ]
        },
        "created_at": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 253402300799
        },
        "message_type": {
          "type": ["integer", "null"],
          "enum": [null, 0, 1, 2, 3]
        },
        "private": { "type": ["boolean", "null"] },
        "sender_type": {
          "type": ["string", "null"],
          "enum": [null, "contact", "user", "agent", "agent_bot", "bot"]
        },
        "event_identity_key_version": {
          "type": ["string", "null"],
          "pattern": "^calapres-identity-hmac-v[1-9][0-9]*$"
        },
        "event_identity_fingerprint": {
          "type": ["string", "null"],
          "pattern": "^[a-f0-9]{64}$"
        },
        "business_claim_id": {
          "type": ["string", "null"],
          "pattern": "^bev_claim_[A-Za-z0-9_-]{4,120}$"
        },
        "job_id": {
          "type": ["string", "null"],
          "pattern": "^job_[A-Za-z0-9_-]{4,120}$"
        },
        "generation": {
          "type": ["integer", "null"],
          "minimum": 1,
          "maximum": 2147483647
        }
      },
      "oneOf": [
        {
          "required": [
            "classification",
            "outcome",
            "reason_code",
            "created_at",
            "message_type",
            "private",
            "sender_type",
            "event_identity_key_version",
            "event_identity_fingerprint",
            "business_claim_id",
            "job_id",
            "generation"
          ],
          "properties": {
            "classification": { "const": "event_candidate" },
            "outcome": { "enum": ["durable_bound", "durable_duplicate"] },
            "reason_code": { "const": null },
            "created_at": { "const": null },
            "message_type": { "const": null },
            "private": { "const": null },
            "sender_type": { "const": null },
            "event_identity_key_version": { "type": "string" },
            "event_identity_fingerprint": { "type": "string" },
            "business_claim_id": { "type": "string" },
            "job_id": { "type": "string" },
            "generation": { "type": "integer" }
          }
        },
        {
          "required": [
            "classification",
            "outcome",
            "reason_code",
            "created_at",
            "message_type",
            "private",
            "sender_type",
            "event_identity_key_version",
            "event_identity_fingerprint",
            "business_claim_id",
            "job_id",
            "generation"
          ],
          "properties": {
            "classification": { "const": "deterministically_excluded" },
            "outcome": { "const": "deterministically_excluded" },
            "reason_code": {
              "enum": [
                "before_activation_floor",
                "private_message",
                "outgoing_message",
                "activity_message",
                "template_message",
                "bot_echo"
              ]
            },
            "created_at": { "type": "integer" },
            "message_type": { "type": "integer" },
            "private": { "type": "boolean" },
            "sender_type": { "type": ["string", "null"] },
            "event_identity_key_version": { "const": null },
            "event_identity_fingerprint": { "const": null },
            "business_claim_id": { "const": null },
            "job_id": { "const": null },
            "generation": { "const": null }
          }
        }
      ]
    }
  }
}
