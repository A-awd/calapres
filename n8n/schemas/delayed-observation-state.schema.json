{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/A-awd/calapres/n8n/schemas/delayed-observation-state.schema.json",
  "title": "Calapres identifiers-only delayed observation state",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "brand_id",
    "account_id",
    "inbox_id",
    "channel",
    "conversation_id",
    "anchor_message_id",
    "conversation_fingerprint",
    "message_fingerprint",
    "correlation_id",
    "idempotency_fingerprint",
    "generation",
    "not_before",
    "knowledge_version",
    "fixture_ref",
    "customer_egress_allowed"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "brand_id": {
      "const": "calapres"
    },
    "account_id": {
      "const": 179973
    },
    "inbox_id": {
      "enum": [
        128031,
        128033,
        128058,
        128326
      ]
    },
    "channel": {
      "enum": [
        "instagram",
        "tiktok",
        "whatsapp",
        "email"
      ]
    },
    "conversation_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,128}$"
    },
    "anchor_message_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,128}$"
    },
    "conversation_fingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "message_fingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "correlation_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]+$"
    },
    "idempotency_fingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "generation": {
      "type": "integer",
      "minimum": 1
    },
    "not_before": {
      "type": "string",
      "format": "date-time"
    },
    "knowledge_version": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}-v[1-9][0-9]*$"
    },
    "fixture_ref": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^fixture_[A-Za-z0-9_-]{6,80}$"
    },
    "customer_egress_allowed": {
      "const": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "channel": {
            "const": "instagram"
          }
        },
        "required": [
          "channel"
        ]
      },
      "then": {
        "properties": {
          "inbox_id": {
            "const": 128031
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "channel": {
            "const": "tiktok"
          }
        },
        "required": [
          "channel"
        ]
      },
      "then": {
        "properties": {
          "inbox_id": {
            "const": 128033
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "channel": {
            "const": "whatsapp"
          }
        },
        "required": [
          "channel"
        ]
      },
      "then": {
        "properties": {
          "inbox_id": {
            "const": 128058
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "channel": {
            "const": "email"
          }
        },
        "required": [
          "channel"
        ]
      },
      "then": {
        "properties": {
          "inbox_id": {
            "const": 128326
          }
        }
      }
    }
  ]
}
