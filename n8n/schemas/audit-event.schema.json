{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/A-awd/calapres/n8n/schemas/audit-event.schema.json",
  "title": "Calapres sanitized customer-service audit event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "brand_id",
    "audit_id",
    "correlation_id",
    "idempotency_key",
    "event_type",
    "outcome",
    "reason_code",
    "actor_type",
    "references",
    "occurred_at"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "brand_id": {
      "const": "calapres"
    },
    "audit_id": {
      "type": "string",
      "pattern": "^aud_[A-Za-z0-9_-]{8,80}$"
    },
    "correlation_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 16,
      "maxLength": 256
    },
    "event_type": {
      "enum": [
        "event_rejected",
        "dedup_hit",
        "generation_advanced",
        "core_evaluated",
        "draft_observed",
        "incident_created",
        "owner_decision_recorded",
        "human_cancelled",
        "kill_switch_stop",
        "lookup_stop",
        "send_blocked"
      ]
    },
    "outcome": {
      "enum": [
        "success",
        "no_action",
        "escalated",
        "rejected"
      ]
    },
    "reason_code": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{2,80}$"
    },
    "actor_type": {
      "enum": [
        "system",
        "owner"
      ]
    },
    "references": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "conversation_ref",
        "incident_id",
        "knowledge_version",
        "workflow_release"
      ],
      "properties": {
        "conversation_ref": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^cwr_[A-Za-z0-9_-]{6,128}$"
        },
        "incident_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^inc_[A-Za-z0-9_-]{8,80}$"
        },
        "knowledge_version": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}-v[1-9][0-9]*$"
        },
        "workflow_release": {
          "type": "string",
          "pattern": "^[a-z0-9-]+-v[1-9][0-9]*$"
        }
      }
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
