{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/A-awd/calapres/n8n/schemas/dedup-record.schema.json",
  "title": "Calapres event deduplication record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "brand_id",
    "idempotency_key",
    "delivery_fingerprint",
    "correlation_id",
    "state",
    "first_seen_at",
    "last_seen_at",
    "expires_at"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "brand_id": {
      "const": "calapres"
    },
    "idempotency_key": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "delivery_fingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "correlation_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128
    },
    "state": {
      "enum": [
        "claimed",
        "observed",
        "rejected"
      ]
    },
    "first_seen_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_seen_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
