{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://calapres.com/schemas/customer-service-release-lock.schema.json",
  "title": "Calapres Customer Service Release Lock",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "release_id",
    "brand_id",
    "mode",
    "files",
    "release_digest_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "release_id": {
      "const": "calapres-customer-service-observation-v1"
    },
    "brand_id": {
      "const": "calapres"
    },
    "mode": {
      "const": "synthetic_test_no_send"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "bytes"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240,
            "pattern": "^(n8n|support/brands/calapres)/[A-Za-z0-9._/-]+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 16777216
          }
        }
      }
    },
    "release_digest_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
