{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/A-awd/calapres/n8n/schemas/order-index-table-row.schema.json",
  "title": "Exact Calapres n8n order-index Data Table row",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "shopify_order_gid",
    "shopify_customer_gid",
    "order_name_fingerprint",
    "email_fingerprint",
    "buyer_phone_fingerprint",
    "recipient_phone_fingerprint",
    "fingerprint_key_version",
    "status_class",
    "order_created_at",
    "order_updated_at",
    "indexed_at",
    "expires_at"
  ],
  "properties": {
    "shopify_order_gid": {
      "type": "string",
      "pattern": "^gid://shopify/Order/[1-9][0-9]{0,30}$"
    },
    "shopify_customer_gid": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^gid://shopify/Customer/[1-9][0-9]{0,30}$"
    },
    "order_name_fingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "email_fingerprint": {
      "$ref": "#/$defs/optional_fingerprint"
    },
    "buyer_phone_fingerprint": {
      "$ref": "#/$defs/optional_fingerprint"
    },
    "recipient_phone_fingerprint": {
      "$ref": "#/$defs/optional_fingerprint"
    },
    "fingerprint_key_version": {
      "type": "string",
      "pattern": "^hmac-sha256-v[1-9][0-9]*$"
    },
    "status_class": {
      "enum": [
        "active",
        "stale",
        "revoked"
      ]
    },
    "order_created_at": {
      "type": "string",
      "format": "date-time"
    },
    "order_updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "indexed_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "optional_fingerprint": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
