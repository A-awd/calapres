{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/A-awd/calapres/n8n/schemas/context-trust-anchor.schema.json",
  "title": "Independent Calapres context trust anchor v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "anchor_id",
    "brand_id",
    "status",
    "model_invocation_allowed",
    "current_knowledge_version",
    "current_response_style_version",
    "source_digests",
    "knowledge_history",
    "response_style_history",
    "freshness_policy",
    "brand_isolation"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "anchor_id": { "type": "string", "minLength": 1, "maxLength": 120 },
    "brand_id": { "const": "calapres" },
    "status": { "const": "observation_build_only" },
    "model_invocation_allowed": { "const": false },
    "current_knowledge_version": { "$ref": "#/$defs/version" },
    "current_response_style_version": { "$ref": "#/$defs/version" },
    "source_digests": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "registry",
        "knowledge_manifest",
        "knowledge_release",
        "response_style_manifest",
        "response_style_release"
      ],
      "properties": {
        "registry": { "$ref": "#/$defs/digest" },
        "knowledge_manifest": { "$ref": "#/$defs/digest" },
        "knowledge_release": { "$ref": "#/$defs/digest" },
        "response_style_manifest": { "$ref": "#/$defs/digest" },
        "response_style_release": { "$ref": "#/$defs/digest" }
      }
    },
    "knowledge_history": { "$ref": "#/$defs/history" },
    "response_style_history": { "$ref": "#/$defs/history" },
    "freshness_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_source_age_days", "allowed_source_hosts"],
      "properties": {
        "max_source_age_days": { "type": "integer", "minimum": 1, "maximum": 366 },
        "allowed_source_hosts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9.-]+$" }
        }
      }
    },
    "brand_isolation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["forbidden_brand_names"],
      "properties": {
        "forbidden_brand_names": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 2, "maxLength": 80 }
        }
      }
    }
  },
  "$defs": {
    "version": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}-v[1-9]\\d*$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "history": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["version", "canonical_digest"],
        "properties": {
          "version": { "$ref": "#/$defs/version" },
          "canonical_digest": { "$ref": "#/$defs/digest" }
        }
      }
    }
  }
}
