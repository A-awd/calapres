{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/A-awd/calapres/n8n/schemas/calapres-operations-health-snapshot.schema.json",
  "title": "Calapres operations health snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "observed_at",
    "overall",
    "telegram_owner_bridge",
    "chatwoot_monitoring"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "overall": {
      "enum": [
        "healthy",
        "degraded",
        "unavailable",
        "unknown"
      ]
    },
    "telegram_owner_bridge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "observed_at",
        "last_success_at",
        "last_failure_at",
        "failure_code"
      ],
      "properties": {
        "status": {
          "enum": [
            "healthy",
            "degraded",
            "unavailable",
            "unknown"
          ]
        },
        "observed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "last_success_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "last_failure_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "failure_code": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Z0-9_]{1,64}$"
        }
      }
    },
    "chatwoot_monitoring": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "observed_at",
        "last_inbound_at",
        "unanswered_count",
        "oldest_unanswered_seconds",
        "failure_code"
      ],
      "properties": {
        "status": {
          "enum": [
            "healthy",
            "degraded",
            "monitoring_unavailable",
            "unknown"
          ]
        },
        "observed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "last_inbound_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "unanswered_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "oldest_unanswered_seconds": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "failure_code": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Z0-9_]{1,64}$"
        }
      }
    }
  }
}
