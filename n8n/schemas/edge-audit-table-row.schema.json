{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/A-awd/calapres/n8n/schemas/edge-audit-table-row.schema.json",
  "title": "Exact live Calapres audit table row preview from the edge",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "brand_id",
    "idempotency_key",
    "outcome",
    "actor_type",
    "conversation_ref",
    "incident_id",
    "knowledge_version",
    "workflow_release",
    "audit_id",
    "correlation_id",
    "created_at",
    "decision",
    "details_sanitized",
    "event_type",
    "reason_code",
    "source_ref"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "brand_id": {
      "const": "calapres"
    },
    "idempotency_key": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "outcome": {
      "enum": [
        "observed_no_write",
        "escalated_no_write",
        "no_action_no_write",
        "rejected_no_write"
      ]
    },
    "actor_type": {
      "const": "system"
    },
    "conversation_ref": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^cwr_[A-Za-z0-9_-]{6,128}$"
    },
    "incident_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^inc_[A-Za-z0-9_-]{8,80}$"
    },
    "knowledge_version": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}-v[1-9][0-9]*$"
    },
    "workflow_release": {
      "const": "calapres-customer-service-edge-v1"
    },
    "audit_id": {
      "type": "string",
      "pattern": "^aud_[A-Za-z0-9_-]{8,80}$"
    },
    "correlation_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128,
      "pattern": "^calapres:[A-Za-z0-9_-]{1,64}:[A-Za-z0-9_-]{1,64}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "decision": {
      "enum": [
        "no_action",
        "observe_draft",
        "escalate"
      ]
    },
    "details_sanitized": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "event_type": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{2,80}$"
    },
    "reason_code": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{2,80}$"
    },
    "source_ref": {
      "type": "string",
      "pattern": "^src_[A-Za-z0-9_-]{8,80}$"
    }
  }
}
