    {
      "id": "65edbb47-081e-479e-993e-72e47020bb39",
      "name": "Humanize Text",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1000,
        140
      ],
      "parameters": {
        "jsCode": "const items = $input.all();\nfor (const item of items) {\n  let t = String(item.json.output || '');\n  // إزالة كل الإيموجيات\n  t = t.replace(/[\\u{1F300}-\\u{1FAFF}\\u{1F000}-\\u{1F0FF}\\u{2600}-\\u{27BF}\\u{FE0F}\\u{200D}\\u{2B00}-\\u{2BFF}\\u{1F900}-\\u{1F9FF}]/gu, '');\n  // إزالة رموز التنسيق: نجوم، شرطات سفلية، باكتيك\n  t = t.replace(/[*_`~#>]/g, '');\n  // تحويل الشرطات الطويلة والقصيرة الفاصلة إلى فاصلة عادية\n  t = t.replace(/\\s*[\\u2014\\u2013\\u2012\\u2015]\\s*/g, '، ');\n  t = t.replace(/\\s+-\\s+/g, '، ');\n  t = t.replace(/--+/g, '، ');\n  // إزالة النقاط المرقمة والقوائم في بداية الأسطر\n  t = t.replace(/^\\s*[\\d٠-٩]+[.)]\\s*/gm, '');\n  t = t.replace(/^\\s*[\\u2022\\u25CF\\u25AA-]\\s*/gm, '');\n  // دمج الأسطر المتعددة في سطر واحد طبيعي\n  t = t.replace(/\\n{2,}/g, ' ').replace(/\\n/g, ' ');\n  // تنظيف المسافات المكررة والفواصل المكسورة\n  t = t.replace(/\\s{2,}/g, ' ').replace(/،\\s*،/g, '،').replace(/\\s+([،.؟!])/g, '$1').trim();\n  // قص أي رد أطول من جملتين: نأخذ أول جملتين فقط\n  const parts = t.split(/(?<=[.؟!])\\s+/).filter(s => s.trim().length > 0);\n  if (parts.length > 2) { t = parts.slice(0, 2).join(' '); }\n  item.json.output = t;\n}\nreturn items;"
      }
    }
