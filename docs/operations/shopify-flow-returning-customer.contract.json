  "workflow": {
    "name": "كالابريز — تمييز العميل العائد",
    "id": "01a17ccd-e467-77c0-86c1-30d8de633825",
    "version": "01M5YDR47RQXJ1QV73W3ASAYJW",
    "activationEvidence": [
      "native-workflow-turned-on-confirmation",
      "editor-turn-off-workflow-control-readback"
    ],
    "runtime": "native-shopify-flow",
    "aiInRuntime": false,
    "n8nInRuntime": false,
    "linearSteps": [
      {
        "position": 1,
        "type": "Order paid"
      },
      {
        "position": 2,
        "type": "Condition",
        "match": "all",
        "conditions": {
          "order.test": false,
          "order.cancelledAt": "does-not-exist",
          "order.customer.id": "not-empty",
          "order.tagsMustContainNone": [
            "تجريبي",
            "عميل-عائد"
          ]
        },
        "falseBranch": "no-action"
      },
      {
        "position": 3,
        "type": "Get order data",
        "maximumResults": 2,
        "sort": {
          "field": "created_at",
          "direction": "DESC"
        },
        "queryTemplate": "customer_id:{{ order.customer.legacyResourceId }} AND (financial_status:paid OR financial_status:partially_refunded) AND -status:cancelled AND tag_not:\"تجريبي\" AND test:false"
      },
      {
        "position": 4,
        "type": "Count",
        "input": "get-order-data-result-list"
      },
      {
        "position": 5,
        "type": "Condition",
        "operator": "greater-than-or-equal",
        "value": 2,
        "nativeDisplayValue": "2.0",
        "falseBranch": "no-action"
      },
      {
        "position": 6,
        "type": "Add customer tags",
        "target": "trigger-order-customer-id",
        "tags": [
          "عميل-عائد"
        ],
        "preserveOtherTags": true
      },
      {
        "position": 7,
        "type": "Add order tags",
        "target": "trigger-order-id",
        "tags": [
          "عميل-عائد"
        ],
        "preserveOtherTags": true
      },
      {
        "position": 8,
        "type": "Send internal email",
        "recipient": "info@calapres.com",
        "subjectTemplate": "كالابريز | عميل عائد — {{ order.name }}",
        "bodyTextTemplate": "تم تسجيل عملية شراء متكررة حقيقية للطلب {{ order.name }}.\n\nعرض الطلب: https://admin.shopify.com/store/unywbe-ub/orders/{{ order.legacyResourceId }}",
        "bodyWhitespacePreservationVerified": false
      }
    ]
  },
