# Copy to /etc/calapres-design/env (owner root, group calapres-design, mode 0640). NEVER commit real values.
# Comments must stay on their own lines: systemd and docker env files do not strip trailing comments.

# ---- Required even while generation is disabled ----
SHOPIFY_SHOP=unywbe-ub.myshopify.com
# Dev Dashboard app client secret (verifies app-proxy and webhook signatures)
SHOPIFY_API_SECRET=
# At least 32 random bytes, e.g. `openssl rand -base64 48`. Rotating it invalidates sessions and receipts.
SERVICE_SECRET=
DATA_DIR=/var/lib/calapres-design
# true on managed hosts (Render): refuse to start unless DATA_DIR is a separately mounted volume
REQUIRE_MOUNTED_DATA_DIR=false
PORT=8787
HOST=127.0.0.1
# Must equal the storefront prefix/subpath Shopify reports as path_prefix
PROXY_PATH_PREFIX=/apps/calapres-design
# Path of the app proxy URL on this server
PROXY_BASE_PATH=/proxy

# ---- Abuse and runtime controls ----
# Soft per-address limit; mobile carriers share addresses
IP_REQUESTS_PER_MINUTE=120
# With the shipped Caddyfile use x-calapres-client-chain; use x-forwarded-for when Shopify reaches Node directly
CLIENT_IP_HEADER=x-calapres-client-chain
TRUSTED_PROXY_HOPS=0
JOBS_PER_HOUR=20
MAX_PENDING_JOBS=4
# OpenAI usage-tier image limit; raise only to the account's verified tier
PROVIDER_IMAGES_PER_MINUTE=5
# An image not sent within this window is skipped and never billed
QUEUE_WAIT_MS=150000
# Single-worker lease on DATA_DIR
LEASE_TTL_MS=30000

# ---- Generation stays OFF until every line below is deliberately set (last step, owner-approved) ----
GENERATION_ENABLED=false
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2-2026-04-21
OPENAI_IMAGE_QUALITY=low
# Official USD prices per 1M tokens, re-read on the activation day. Deliberately left blank.
PRICE_TEXT_INPUT_USD_PER_M=
PRICE_IMAGE_INPUT_USD_PER_M=0
PRICE_IMAGE_OUTPUT_USD_PER_M=
# Operator ceiling for billed output tokens of ONE image. The API cannot enforce it; observed usage
# above it is recorded and halts generation after that batch.
MAX_OUTPUT_TOKENS_PER_IMAGE=
# Lifetime RESERVATION budget in USD micro-units (1 USD = 1000000). 0 = disabled.
# A reservation policy enforced by this service, not a provider invoice cap. A provider-side
# limit (prepaid balance with auto-recharge off, project budget) reduces exposure but is not a
# verified hard cap: dispatch, usage reporting and cutoff can lag.
BUDGET_USD_MICROS=0
