{%- comment -%}
  Shop page (.shop-head + .products) ported 1:1 from the
  static prototype. Renders the current collection's products;
  add-to-cart buttons post to the Shopify AJAX Cart API via
  calabriz-cart.js (data-add = variant id).
{%- endcomment -%}
<section class="shop-head">
  <div class="wrap">
    <h1>{{ section.settings.heading | default: collection.title }}</h1>
    {%- assign mc_subtext = section.settings.subtext | default: collection.description -%}
    {%- if mc_subtext != blank -%}
    <p>{{ mc_subtext | strip_html }}</p>
    {%- endif -%}
  </div>
</section>

<section class="products">
  <div class="wrap">
    {%- paginate collection.products by 12 -%}
    <div class="prod-grid">
      {%- for mc_product in collection.products -%}
      {% render 'product-card', card_product: mc_product, show_add: true %}
      {%- else -%}
      <p class="form-note">لا توجد منتجات في هذه المجموعة حاليًا.</p>
      {%- endfor -%}
    </div>
    {%- if paginate.pages > 1 -%}
    <div class="sec-head" style="margin-top:2rem">
      {%- if paginate.previous -%}<a class="link-arrow" href="{{ paginate.previous.url }}">السابق</a>{%- endif -%}
      {%- if paginate.next -%}<a class="link-arrow" href="{{ paginate.next.url }}">التالي</a>{%- endif -%}
    </div>
    {%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{
  "name": "صفحة المتجر",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "العنوان (يُترك فارغًا لعرض اسم المجموعة)"
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "النص التحتي (يُترك فارغًا لعرض وصف المجموعة)"
    }
  ]
}
{% endschema %}
