{%- comment -%}
  Cart page — a server-rendered safety net for the AJAX cart
  drawer (not part of the static prototype's 7 pages), styled
  with the same design language. Quantities update through the
  native /cart form; the engraving line item property
  "نص الحفر" is shown per line.
{%- endcomment -%}
<section class="cart-page">
  <div class="wrap">
    <h1>سلّة التسوّق</h1>
    {%- if cart.item_count == 0 -%}
    <div class="d-empty">
      <p>سلّتك فارغة.</p>
      <a class="link-arrow" href="{{ routes.all_products_collection_url }}">تصفّح المتجر <span>←</span></a>
    </div>
    {%- else -%}
    <form action="{{ routes.cart_url }}" method="post" novalidate>
      {%- for item in cart.items -%}
      {%- liquid
        assign ci_parts = item.product.title | split: '—'
        assign ci_name = ci_parts | first | strip
        assign ci_color = ''
        if item.variant.title != 'Default Title'
          assign ci_color = item.variant.title
        elsif ci_parts.size > 1
          assign ci_color = ci_parts | last | strip
        endif
      -%}
      <div class="d-item">
        {%- if item.image -%}
        <img src="{{ item.image | image_url: width: 144 }}" alt="{{ item.title | escape }}" width="144" height="144">
        {%- endif -%}
        <div class="di-info">
          <h4><a href="{{ item.url }}">{{ ci_name }}</a></h4>
          {%- if ci_color != blank -%}
          <div class="di-color">اللون: {{ ci_color }}</div>
          {%- endif -%}
          {%- assign ci_eng = item.properties['نص الحفر'] -%}
          {%- if ci_eng != blank -%}
          <div class="di-eng">الحفر: «{{ ci_eng }}»</div>
          {%- endif -%}
          <div class="d-row">
            <span class="qty">
              <input type="number" name="updates[]" value="{{ item.quantity }}" min="0" aria-label="الكمية">
            </span>
            <span class="di-price">{% render 'price-sar', cents: item.final_line_price %}</span>
          </div>
          <a class="di-remove" href="{{ item.url_to_remove }}">إزالة</a>
        </div>
      </div>
      {%- endfor -%}
      <div class="cart-total"><span>الإجمالي</span><b>{% render 'price-sar', cents: cart.total_price %}</b></div>
      <a
        class="national-address-help"
        href="https://wa.me/966112898888?text=%D8%A7%D9%84%D8%B9%D9%86%D9%88%D8%A7%D9%86%20%D8%A7%D9%84%D9%88%D8%B7%D9%86%D9%8A"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="معرفة العنوان الوطني المختصر عبر واتساب سبل"
      >
        <span class="national-address-help__message">لتسهيل شحنتك، أضف عنوانك المختصر في صفحة الدفع.</span>
        <strong class="national-address-help__action">لا تعرف عنوانك المختصر؟ اعرفه عبر واتساب سبل ↗</strong>
      </a>
      <div class="cart-actions">
        <button class="btn-dark" type="submit" name="update">تحديث السلّة</button>
        <button class="btn-dark" type="submit" name="checkout">إتمام الطلب</button>
      </div>
    </form>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "صفحة السلّة",
  "settings": []
}
{% endschema %}
