{%- comment -%}
  Product page (.pd + .related) ported 1:1 from the static
  prototype, fully data-driven:
  - Each color of the mibkhara set is its own Shopify product,
    so the color switcher links between sibling products of the
    configured collection (the static ?color= query becomes real
    product URLs).
  - Price / compare-at / savings tag come from the live variant.
  - The engraving field posts as line item property "نص الحفر"
    through the Shopify AJAX Cart API (calabriz-cart.js), with a
    native /cart/add fallback when JS is unavailable.
{%- endcomment -%}
{%- liquid
  assign mp_variant = product.selected_or_first_available_variant
  assign mp_parts = product.title | split: '—'
  assign mp_name = mp_parts | first | strip
  assign mp_color = ''
  if mp_parts.size > 1
    assign mp_color = mp_parts | last | strip
  endif
  assign mp_price = mp_variant.price
  assign mp_compare = mp_variant.compare_at_price
  assign mp_save = 0
  if mp_compare > mp_price
    assign mp_save = mp_compare | minus: mp_price
  endif
  assign mp_siblings = section.settings.sibling_collection
  if mp_siblings == blank
    assign mp_siblings = product.collections | first
  endif
  assign mp_image = mp_variant.image | default: product.featured_image
-%}
<main class="wrap">
  <div class="pd">
    <div class="pd-media">
      {%- if mp_save > 0 %}<span class="tag">وفّر {% render 'price-sar', cents: mp_save %}</span>{% endif -%}
      {%- if mp_image -%}
      <img id="pdImg" src="{{ mp_image | image_url: width: 1200 }}" alt="{{ mp_image.alt | default: product.title | escape }}" width="1200" height="1200">
      {%- else -%}
      {{ 'product-1' | placeholder_svg_tag }}
      {%- endif -%}
    </div>
    <div class="pd-info">
      <p class="eyebrow">{{ mp_name }}</p>
      <h1 id="pdTitle">{{ product.title }}</h1>
      <div class="price"><b>{% render 'price-sar', cents: mp_price %}</b>{% if mp_save > 0 %}<s>{% render 'price-sar', cents: mp_compare %}</s>{% endif %}</div>
      {%- if section.settings.line1 != blank -%}
      <p class="pd-line">{{ section.settings.line1 }}</p>
      {%- endif -%}
      {%- if section.settings.line2 != blank -%}
      <p class="pd-line">{{ section.settings.line2 }}</p>
      {%- endif -%}

      {%- if mp_siblings.products.size > 1 -%}
      <div class="pd-colors">
        <div class="clbl">اللون: <b id="pdColorName">{{ mp_color | default: product.title }}</b></div>
        <div class="cbtns" id="colorBtns">
          {%- for mp_sib in mp_siblings.products -%}
          {%- liquid
            assign sib_parts = mp_sib.title | split: '—'
            assign sib_color = sib_parts | last | strip
            case sib_color
              when 'الأبيض'
                assign sib_swatch = '#F5F4F0'
              when 'البيج'
                assign sib_swatch = '#D9C6A5'
              when 'الرمادي'
                assign sib_swatch = '#9A9A96'
              else
                assign sib_swatch = 'var(--panel)'
            endcase
          -%}
          <a class="cbtn{% if mp_sib.id == product.id %} on{% endif %}" href="{{ mp_sib.url }}" aria-label="{{ sib_color | escape }}"><i style="background:{{ sib_swatch }}"></i>{{ sib_color }}</a>
          {%- endfor -%}
        </div>
      </div>
      {%- endif -%}

      {% form 'product', product, id: 'pdForm', data-product-form: 'true' %}
        <input type="hidden" name="id" value="{{ mp_variant.id }}">
        <div class="pd-eng">
          <label for="engInput">الاسم أو الشعار للحفر (اختياري)</label>
          <input type="text" id="engInput" name="properties[نص الحفر]" maxlength="40" placeholder="مثال: سارة ومحمد — ١٤٤٧هـ">
        </div>
        <button class="btn-dark" id="pdAdd" type="submit"{% unless product.available %} disabled{% endunless %}>
          {%- if product.available -%}
          أضِف إلى السلّة — {% render 'price-sar', cents: mp_price %}
          {%- else -%}
          غير متوفر حاليًا
          {%- endif -%}
        </button>
      {% endform %}

      {%- if section.blocks.size > 0 -%}
      <div class="acc" id="acc">
        {%- for block in section.blocks -%}
        <div class="acc-item" {{ block.shopify_attributes }}>
          <button class="acc-q" aria-expanded="false">{{ block.settings.question }} <span class="ic">+</span></button>
          <div class="acc-a"><p>{{ block.settings.answer }}</p></div>
        </div>
        {%- endfor -%}
      </div>
      {%- endif -%}
    </div>
  </div>
</main>

{%- liquid
  assign rel_products = ''
  if mp_siblings.products.size > 1
    assign rel_products = 'yes'
  endif
  assign rel_soon = section.settings.soon_product
-%}
{%- if rel_products == 'yes' or rel_soon or section.settings.soon_label != blank -%}
<section class="related wrap">
  <div class="sec-head">
    <h2>{{ section.settings.related_heading }}</h2>
    {%- if mp_siblings -%}
    <a class="link-arrow" href="{{ mp_siblings.url }}">{{ section.settings.related_link_label }} <span>←</span></a>
    {%- else -%}
    <a class="link-arrow" href="{{ routes.all_products_collection_url }}">{{ section.settings.related_link_label }} <span>←</span></a>
    {%- endif -%}
  </div>
  <div class="prod-grid" id="relGrid">
    {%- if rel_products == 'yes' -%}
    {%- for mp_sib in mp_siblings.products -%}
    {%- unless mp_sib.id == product.id -%}
    {% render 'product-card', card_product: mp_sib, show_add: false %}
    {%- endunless -%}
    {%- endfor -%}
    {%- endif -%}
    {%- liquid
      assign soon_label = section.settings.soon_label
      if soon_label == blank and rel_soon
        assign soon_parts = rel_soon.title | split: '—'
        assign soon_label = soon_parts | first | strip
      endif
    -%}
    <div class="cat-tile">
      {%- if section.settings.soon_badge != blank -%}
      <span class="badge">{{ section.settings.soon_badge }}</span>
      {%- endif -%}
      {%- if section.settings.soon_image -%}
      <img src="{{ section.settings.soon_image | image_url: width: 1400 }}" alt="{{ soon_label | escape }}" loading="lazy" width="{{ section.settings.soon_image.width }}" height="{{ section.settings.soon_image.height }}">
      {%- elsif rel_soon.featured_image -%}
      <img src="{{ rel_soon.featured_image | image_url: width: 1400 }}" alt="{{ soon_label | escape }}" loading="lazy" width="{{ rel_soon.featured_image.width }}" height="{{ rel_soon.featured_image.height }}">
      {%- else -%}
      <img src="{{ 'atmo-silk.jpg' | asset_url }}" alt="{{ soon_label | escape }}" loading="lazy" width="1536" height="942">
      {%- endif -%}
      <span class="lbl">{{ soon_label }}{% if rel_soon %} <span class="soon-price">{% render 'price-sar', cents: rel_soon.price %}</span>{% endif %}</span>
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "صفحة المنتج",
  "settings": [
    {
      "type": "collection",
      "id": "sibling_collection",
      "label": "مجموعة ألوان الطقم",
      "info": "منتجات هذه المجموعة تظهر كخيارات ألوان. عند تركها فارغة تُستخدم أول مجموعة ينتمي إليها المنتج."
    },
    {
      "type": "text",
      "id": "line1",
      "label": "السطر الأول",
      "default": "ستاند + مبخر أنيق + علبة عود"
    },
    {
      "type": "text",
      "id": "line2",
      "label": "السطر الثاني",
      "default": "حفر الاسم أو الشعار"
    },
    {
      "type": "text",
      "id": "related_heading",
      "label": "عنوان قسم قد يعجبك",
      "default": "قد يعجبك أيضًا"
    },
    {
      "type": "text",
      "id": "related_link_label",
      "label": "نص رابط عرض الكل",
      "default": "عرض الكل"
    },
    {
      "type": "product",
      "id": "soon_product",
      "label": "المنتج القادم (بلاطة قريباً)"
    },
    {
      "type": "text",
      "id": "soon_label",
      "label": "عنوان بلاطة قريباً (يُترك فارغًا لعرض اسم المنتج)",
      "default": "ستاند عقد قران فاخر للآيباد"
    },
    {
      "type": "text",
      "id": "soon_badge",
      "label": "شارة بلاطة قريباً",
      "default": "قريباً"
    },
    {
      "type": "image_picker",
      "id": "soon_image",
      "label": "صورة بلاطة قريباً"
    }
  ],
  "blocks": [
    {
      "type": "qa",
      "name": "سؤال وجواب",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "السؤال",
          "default": "ماذا يتضمّن الطقم؟"
        },
        {
          "type": "textarea",
          "id": "answer",
          "label": "الجواب",
          "default": "الطقم واحد متكامل: ستاند، ومبخر أنيق، وعلبة عود — كلّها باللون الذي تختاره."
        }
      ]
    }
  ]
}
{% endschema %}
