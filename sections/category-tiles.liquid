{%- comment -%}
  Category row (.cats) ported 1:1 from the static prototype:
  tile 1 links a real collection, tile 2 previews the
  coming-soon product with a "قريباً" badge. Images fall back
  from the picked image → live resource image → prototype asset.
{%- endcomment -%}
{%- liquid
  assign t1_collection = section.settings.tile1_collection
  assign t1_url = t1_collection.url | default: routes.all_products_collection_url
  assign t1_label = section.settings.tile1_label | default: t1_collection.title
  assign t2_product = section.settings.tile2_product
  assign t2_url = t2_product.url | default: routes.all_products_collection_url
  assign t2_label = section.settings.tile2_label
  if t2_label == blank and t2_product
    assign t2_parts = t2_product.title | split: '—'
    assign t2_label = t2_parts | first | strip
  endif
-%}
<section class="wrap cats">
  <a class="cat-tile" href="{{ t1_url }}">
    {%- if section.settings.tile1_image -%}
    <img src="{{ section.settings.tile1_image | image_url: width: 1400 }}" alt="{{ t1_label | escape }}" loading="lazy" width="{{ section.settings.tile1_image.width }}" height="{{ section.settings.tile1_image.height }}">
    {%- elsif t1_collection.image -%}
    <img src="{{ t1_collection.image | image_url: width: 1400 }}" alt="{{ t1_label | escape }}" loading="lazy" width="{{ t1_collection.image.width }}" height="{{ t1_collection.image.height }}">
    {%- else -%}
    <img src="{{ 'product-gray.jpg' | asset_url }}" alt="{{ t1_label | escape }}" loading="lazy" width="6372" height="6371">
    {%- endif -%}
    <span class="lbl">{{ t1_label }} <span>←</span></span>
  </a>
  <a class="cat-tile" href="{{ t2_url }}">
    {%- if section.settings.tile2_badge != blank -%}
    <span class="badge">{{ section.settings.tile2_badge }}</span>
    {%- endif -%}
    {%- if section.settings.tile2_image -%}
    <img src="{{ section.settings.tile2_image | image_url: width: 1400 }}" alt="{{ t2_label | escape }}" loading="lazy" width="{{ section.settings.tile2_image.width }}" height="{{ section.settings.tile2_image.height }}">
    {%- elsif t2_product.featured_image -%}
    <img src="{{ t2_product.featured_image | image_url: width: 1400 }}" alt="{{ t2_label | escape }}" loading="lazy" width="{{ t2_product.featured_image.width }}" height="{{ t2_product.featured_image.height }}">
    {%- else -%}
    <img src="{{ 'atmo-silk.jpg' | asset_url }}" alt="{{ t2_label | escape }}" loading="lazy" width="1536" height="942">
    {%- endif -%}
    <span class="lbl">{{ t2_label }} <span>←</span></span>
  </a>
</section>

{% schema %}
{
  "name": "بلاطات التصنيفات",
  "settings": [
    {
      "type": "collection",
      "id": "tile1_collection",
      "label": "مجموعة البلاطة الأولى"
    },
    {
      "type": "text",
      "id": "tile1_label",
      "label": "عنوان البلاطة الأولى",
      "default": "المباخر"
    },
    {
      "type": "image_picker",
      "id": "tile1_image",
      "label": "صورة البلاطة الأولى"
    },
    {
      "type": "product",
      "id": "tile2_product",
      "label": "منتج البلاطة الثانية (قريباً)"
    },
    {
      "type": "text",
      "id": "tile2_label",
      "label": "عنوان البلاطة الثانية",
      "default": "ستاند عقد القران"
    },
    {
      "type": "text",
      "id": "tile2_badge",
      "label": "شارة البلاطة الثانية",
      "default": "قريباً"
    },
    {
      "type": "image_picker",
      "id": "tile2_image",
      "label": "صورة البلاطة الثانية"
    }
  ],
  "presets": [
    {
      "name": "بلاطات التصنيفات"
    }
  ]
}
{% endschema %}
