{%- comment -%}
  Homepage products grid (.products) ported 1:1 from the
  static prototype. Cards come from a real collection —
  each color of the mibkhara set is its own product.
{%- endcomment -%}
<section class="products">
  <div class="wrap">
    <div class="sec-head">
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.link_label != blank -%}
      {%- if section.settings.collection -%}
      <a class="link-arrow" href="{{ section.settings.collection.url }}">{{ section.settings.link_label }} <span>←</span></a>
      {%- else -%}
      <a class="link-arrow" href="{{ routes.all_products_collection_url }}">{{ section.settings.link_label }} <span>←</span></a>
      {%- endif -%}
      {%- endif -%}
    </div>
    <div class="prod-grid">
      {%- assign fp_collection = section.settings.collection | default: collections.all -%}
      {%- for fp_product in fp_collection.products limit: section.settings.limit -%}
      {% render 'product-card', card_product: fp_product, show_add: false %}
      {%- else -%}
      {%- for i in (1..3) -%}
      <div class="pcard">
        <div class="ph">{{ 'product-1' | placeholder_svg_tag }}</div>
        <div class="pbody"><h3>منتج</h3></div>
      </div>
      {%- endfor -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "شبكة المنتجات",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "العنوان",
      "default": "المباخر"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "نص رابط عرض الكل",
      "default": "عرض الكل"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "المجموعة"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "عدد المنتجات",
      "min": 3,
      "max": 12,
      "step": 3,
      "default": 3
    }
  ],
  "presets": [
    {
      "name": "شبكة المنتجات"
    }
  ]
}
{% endschema %}
