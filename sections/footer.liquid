{%- comment -%}
  Footer (.ftr) ported 1:1 from the static prototype.
  - Newsletter signup is a real Shopify customer form.
  - Columns render assigned menus when set; otherwise they fall
    back to the prototype's link set built from live routes.
  - The products column lists each color product of the
    featured collection dynamically.
{%- endcomment -%}
{%- assign about_url = pages['about'].url | default: routes.root_url -%}
{%- assign contact_url = pages['contact'].url | default: routes.root_url -%}
{%- assign faq_url = pages['faq'].url | default: routes.root_url -%}
<footer class="ftr" id="signup">
  <div class="wrap">
    <div class="ftr-signup">
      <div>
        <h3>{{ section.settings.signup_heading }}</h3>
        <p>{{ section.settings.signup_text }}</p>
      </div>
      {% form 'customer', id: 'signupForm', class: 'signup-form' %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <input type="hidden" name="return_to" value="{{ request.path }}?subscribed=1">
        <input type="email" name="contact[email]" required placeholder="بريدك الإلكتروني" aria-label="البريد الإلكتروني">
        <button type="submit">اشترك</button>
      {% endform %}
    </div>
    <div class="ftr-cols">
      <div>
        <h4>{{ section.settings.col1_heading }}</h4>
        <ul>
          {%- if section.settings.col1_menu.links.size > 0 -%}
          {%- for link in section.settings.col1_menu.links -%}
          <li><a href="{{ link.url }}">{{ link.title }}</a></li>
          {%- endfor -%}
          {%- else -%}
          <li><a href="{{ about_url }}">من نحن</a></li>
          <li><a href="{{ contact_url }}">تواصل معنا</a></li>
          {%- endif -%}
        </ul>
      </div>
      <div>
        <h4>{{ section.settings.col2_heading }}</h4>
        <ul>
          {%- if section.settings.col2_menu.links.size > 0 -%}
          {%- for link in section.settings.col2_menu.links -%}
          <li><a href="{{ link.url }}">{{ link.title }}</a></li>
          {%- endfor -%}
          {%- else -%}
          <li><a href="{{ faq_url }}">الأسئلة الشائعة</a></li>
          <li><a href="{{ faq_url }}">السياسات</a></li>
          {%- endif -%}
        </ul>
      </div>
      <div>
        <h4>{{ section.settings.col3_heading }}</h4>
        <ul>
          {%- if section.settings.col3_menu.links.size > 0 -%}
          {%- for link in section.settings.col3_menu.links -%}
          <li><a href="{{ link.url }}">{{ link.title }}</a></li>
          {%- endfor -%}
          {%- else -%}
          <li><a href="{{ routes.all_products_collection_url }}">المباخر</a></li>
          <li><a href="{{ routes.all_products_collection_url }}">ستاند عقد القران</a></li>
          {%- endif -%}
        </ul>
      </div>
      <div>
        <h4>{{ section.settings.col4_heading }}</h4>
        <ul>
          {%- assign col4_products = section.settings.col4_collection.products -%}
          {%- if col4_products.size > 0 -%}
          {%- for col4_product in col4_products limit: 6 -%}
          {%- assign col4_parts = col4_product.title | split: '—' -%}
          <li><a href="{{ col4_product.url }}">{% if col4_parts.size > 1 %}{{ col4_parts | last | strip }}{% else %}{{ col4_product.title }}{% endif %}</a></li>
          {%- endfor -%}
          {%- else -%}
          <li><a href="{{ routes.all_products_collection_url }}">المباخر</a></li>
          {%- endif -%}
        </ul>
      </div>
    </div>
    <div class="ftr-bottom">
      {%- assign ftr_year = 'now' | date: '%Y' -%}
      <span>© {% render 'arabic-digits', value: ftr_year %} {{ section.settings.copyright_name }}</span>
      <nav>
        <a href="{{ about_url }}">من نحن</a>
        <a href="{{ contact_url }}">تواصل معنا</a>
        <a href="{{ faq_url }}">الأسئلة الشائعة</a>
        <a href="{{ faq_url }}">السياسات</a>
      </nav>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "الفوتر",
  "settings": [
    {
      "type": "text",
      "id": "signup_heading",
      "label": "عنوان تسجيل البريد",
      "default": "تسجيل البريد"
    },
    {
      "type": "text",
      "id": "signup_text",
      "label": "نص تسجيل البريد",
      "default": "اشترك ليصلك جديد كالابريز وإطلاق ستاند عقد القران."
    },
    {
      "type": "text",
      "id": "col1_heading",
      "label": "عنوان العمود الأول",
      "default": "كالابريز"
    },
    {
      "type": "link_list",
      "id": "col1_menu",
      "label": "قائمة العمود الأول"
    },
    {
      "type": "text",
      "id": "col2_heading",
      "label": "عنوان العمود الثاني",
      "default": "المساعدة"
    },
    {
      "type": "link_list",
      "id": "col2_menu",
      "label": "قائمة العمود الثاني"
    },
    {
      "type": "text",
      "id": "col3_heading",
      "label": "عنوان العمود الثالث",
      "default": "المتجر"
    },
    {
      "type": "link_list",
      "id": "col3_menu",
      "label": "قائمة العمود الثالث"
    },
    {
      "type": "text",
      "id": "col4_heading",
      "label": "عنوان عمود المنتجات",
      "default": "المنتجات"
    },
    {
      "type": "collection",
      "id": "col4_collection",
      "label": "مجموعة عمود المنتجات"
    },
    {
      "type": "text",
      "id": "copyright_name",
      "label": "اسم حقوق النشر",
      "default": "كالابريز"
    }
  ]
}
{% endschema %}
