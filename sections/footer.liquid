{%- comment -%}
  Footer (.ftr) ported 1:1 from the static prototype.
  - Newsletter signup is a real Shopify customer form.
  - Columns render assigned menus when set; otherwise they fall
    back to the prototype's link set built from live routes.
  - The products column lists each color product of the
    featured collection dynamically.
{%- endcomment -%}
{%- assign about_url = pages['about'].url | default: routes.root_url -%}
{%- assign contact_url = pages['contact'].url | default: routes.root_url -%}
{%- assign faq_url = pages['faq'].url | default: routes.root_url -%}
{%- assign refund_policy_url = shop.refund_policy.url | default: faq_url -%}
{%- assign shipping_policy_url = shop.shipping_policy.url | default: faq_url -%}
{%- assign privacy_policy_url = shop.privacy_policy.url | default: faq_url -%}
{%- assign terms_policy_url = shop.terms_of_service.url | default: faq_url -%}
{%- assign oud_collection = collections['oud-bakhour'] -%}
{%- assign footer_email = section.settings.email_address | default: shop.email -%}
<footer class="ftr" id="signup">
  <div class="wrap">
    <div class="ftr-signup">
      <div>
        <h3>{{ section.settings.signup_heading }}</h3>
        <p>{{ section.settings.signup_text }}</p>
      </div>
      {% form 'customer', id: 'signupForm', class: 'signup-form' %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <input type="hidden" name="return_to" value="{{ request.path }}?subscribed=1">
        <input type="email" name="contact[email]" required placeholder="بريدك الإلكتروني" aria-label="البريد الإلكتروني">
        <button type="submit">اشترك</button>
      {% endform %}
    </div>
    <div class="ftr-cols">
      <div>
        <h4>{{ section.settings.col1_heading }}</h4>
        <ul>
          {%- if section.settings.col1_menu.links.size > 0 -%}
          {%- for link in section.settings.col1_menu.links -%}
          <li><a href="{{ link.url }}">{{ link.title }}</a></li>
          {%- endfor -%}
          {%- else -%}
          <li><a href="{{ about_url }}">من نحن</a></li>
          <li><a href="{{ contact_url }}">تواصل معنا</a></li>
          {%- endif -%}
        </ul>
      </div>
      <div>
        <h4>{{ section.settings.col2_heading }}</h4>
        <ul>
          {%- if section.settings.col2_menu.links.size > 0 -%}
          {%- for link in section.settings.col2_menu.links -%}
          <li><a href="{{ link.url }}">{{ link.title }}</a></li>
          {%- endfor -%}
          {%- else -%}
          <li><a href="{{ faq_url }}">الأسئلة الشائعة</a></li>
          <li><a href="{{ refund_policy_url }}">سياسة الاسترجاع</a></li>
          <li><a href="{{ shipping_policy_url }}">سياسة الشحن</a></li>
          <li><a href="{{ privacy_policy_url }}">سياسة الخصوصية</a></li>
          <li><a href="{{ terms_policy_url }}">شروط الخدمة</a></li>
          {%- endif -%}
        </ul>
      </div>
      <div>
        <h4>{{ section.settings.col3_heading }}</h4>
        <ul>
          {%- if section.settings.col3_menu.links.size > 0 -%}
          {%- for link in section.settings.col3_menu.links -%}
          <li><a href="{{ link.url }}">{{ link.title }}</a></li>
          {%- endfor -%}
          {%- else -%}
          <li><a href="{{ oud_collection.url | default: routes.all_products_collection_url }}">المباخر</a></li>
          {%- endif -%}
        </ul>
      </div>
      <div class="ftr-social">
        <h4>{{ section.settings.col4_heading }}</h4>
        {%- comment -%}
          Instagram, Snapchat, and TikTok glyph assets are vendored from Shopify Dawn at commit
          bc39a7d2024f1e5c14c42f855bd3552b4913e204.
          See assets/DAWN-SOCIAL-ICONS-LICENSE.txt.
          The WhatsApp glyph is the unmodified black digital SVG from Meta's
          2026 WhatsApp Brand Resource Center logo pack. The X glyph is from
          X's official Brand Toolkit. The email glyph is vendored from Shopify
          Polaris at commit af6ffb66a5b1d20f6c2c898b334a1ebb53728ba2.
          The source SVG files stay unchanged; CSS uses their alpha shapes as masks so every
          storefront glyph renders in the approved Calapres interface ink.
        {%- endcomment -%}
        <div class="social-links" aria-label="حسابات التواصل الاجتماعي">
          {%- if section.settings.instagram_url != blank -%}
          <a class="social-link social-link--instagram" href="{{ section.settings.instagram_url }}" target="_blank" rel="noopener" aria-label="إنستغرام"></a>
          {%- else -%}
          <span class="social-link social-link--instagram social-link--disabled" aria-label="إنستغرام"></span>
          {%- endif -%}
          {%- if section.settings.snapchat_url != blank -%}
          <a class="social-link social-link--snapchat" href="{{ section.settings.snapchat_url }}" target="_blank" rel="noopener" aria-label="سناب شات"></a>
          {%- else -%}
          <span class="social-link social-link--snapchat social-link--disabled" aria-label="سناب شات"></span>
          {%- endif -%}
          {%- if section.settings.tiktok_url != blank -%}
          <a class="social-link social-link--tiktok" href="{{ section.settings.tiktok_url }}" target="_blank" rel="noopener" aria-label="تيك توك"></a>
          {%- else -%}
          <span class="social-link social-link--tiktok social-link--disabled" aria-label="تيك توك"></span>
          {%- endif -%}
          {%- if section.settings.whatsapp_url != blank -%}
          <a class="social-link social-link--whatsapp" href="{{ section.settings.whatsapp_url }}" target="_blank" rel="noopener" aria-label="واتساب"></a>
          {%- else -%}
          <span class="social-link social-link--whatsapp social-link--disabled" aria-label="واتساب"></span>
          {%- endif -%}
          {%- if section.settings.x_url != blank -%}
          <a class="social-link social-link--x" href="{{ section.settings.x_url }}" target="_blank" rel="noopener" aria-label="إكس"></a>
          {%- else -%}
          <span class="social-link social-link--x social-link--disabled" aria-label="إكس"></span>
          {%- endif -%}
          {%- if footer_email != blank -%}
          <a class="social-link social-link--email" href="mailto:{{ footer_email | strip | escape }}" aria-label="البريد الإلكتروني"></a>
          {%- else -%}
          <span class="social-link social-link--email social-link--disabled" aria-label="البريد الإلكتروني"></span>
          {%- endif -%}
        </div>
      </div>
    </div>
    <div class="ftr-bottom">
      {%- assign ftr_year = 'now' | date: '%Y' -%}
      <span>© {% render 'arabic-digits', value: ftr_year %} {{ section.settings.copyright_name }}</span>
      <nav>
        <a href="{{ about_url }}">من نحن</a>
        <a href="{{ contact_url }}">تواصل معنا</a>
        <a href="{{ faq_url }}">الأسئلة الشائعة</a>
        <a href="{{ privacy_policy_url }}">سياسة الخصوصية</a>
        <a href="{{ terms_policy_url }}">شروط الخدمة</a>
      </nav>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "الفوتر",
  "settings": [
    {
      "type": "text",
      "id": "signup_heading",
      "label": "عنوان تسجيل البريد",
      "default": "تسجيل البريد"
    },
    {
      "type": "text",
      "id": "signup_text",
      "label": "نص تسجيل البريد",
      "default": "اشترك ليصلك جديد كالابريز."
    },
    {
      "type": "text",
      "id": "col1_heading",
      "label": "عنوان العمود الأول",
      "default": "كالابريز"
    },
    {
      "type": "link_list",
      "id": "col1_menu",
      "label": "قائمة العمود الأول"
    },
    {
      "type": "text",
      "id": "col2_heading",
      "label": "عنوان العمود الثاني",
      "default": "المساعدة"
    },
    {
      "type": "link_list",
      "id": "col2_menu",
      "label": "قائمة العمود الثاني"
    },
    {
      "type": "text",
      "id": "col3_heading",
      "label": "عنوان العمود الثالث",
      "default": "المتجر"
    },
    {
      "type": "link_list",
      "id": "col3_menu",
      "label": "قائمة العمود الثالث"
    },
    {
      "type": "text",
      "id": "col4_heading",
      "label": "عنوان عمود التواصل",
      "default": "تابعنا"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "رابط إنستغرام"
    },
    {
      "type": "url",
      "id": "snapchat_url",
      "label": "رابط سناب شات"
    },
    {
      "type": "url",
      "id": "tiktok_url",
      "label": "رابط تيك توك"
    },
    {
      "type": "url",
      "id": "whatsapp_url",
      "label": "رابط واتساب"
    },
    {
      "type": "url",
      "id": "x_url",
      "label": "رابط إكس"
    },
    {
      "type": "text",
      "id": "email_address",
      "label": "البريد الإلكتروني",
      "default": "info@calapres.com"
    },
    {
      "type": "text",
      "id": "copyright_name",
      "label": "اسم حقوق النشر",
      "default": "كالابريز"
    }
  ]
}
{% endschema %}
