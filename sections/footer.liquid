{%- comment -%}
  Footer (.ftr) ported 1:1 from the static prototype.
  - Newsletter signup is a real Shopify customer form.
  - Columns render assigned menus when set; otherwise they fall
    back to the prototype's link set built from live routes.
  - The products column lists each color product of the
    featured collection dynamically.
{%- endcomment -%}
{%- assign about_url = pages['about'].url | default: routes.root_url -%}
{%- assign contact_url = pages['contact'].url | default: routes.root_url -%}
{%- assign faq_url = pages['faq'].url | default: routes.root_url -%}
{%- assign oud_collection = collections['oud-bakhour'] -%}
{%- assign wedding_collection = collections['ستاند-عقد-القران'] -%}
<footer class="ftr" id="signup">
  <div class="wrap">
    <div class="ftr-signup">
      <div>
        <h3>{{ section.settings.signup_heading }}</h3>
        <p>{{ section.settings.signup_text }}</p>
      </div>
      {% form 'customer', id: 'signupForm', class: 'signup-form' %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <input type="hidden" name="return_to" value="{{ request.path }}?subscribed=1">
        <input type="email" name="contact[email]" required placeholder="بريدك الإلكتروني" aria-label="البريد الإلكتروني">
        <button type="submit">اشترك</button>
      {% endform %}
    </div>
    <div class="ftr-cols">
      <div>
        <h4>{{ section.settings.col1_heading }}</h4>
        <ul>
          {%- if section.settings.col1_menu.links.size > 0 -%}
          {%- for link in section.settings.col1_menu.links -%}
          <li><a href="{{ link.url }}">{{ link.title }}</a></li>
          {%- endfor -%}
          {%- else -%}
          <li><a href="{{ about_url }}">من نحن</a></li>
          <li><a href="{{ contact_url }}">تواصل معنا</a></li>
          {%- endif -%}
        </ul>
      </div>
      <div>
        <h4>{{ section.settings.col2_heading }}</h4>
        <ul>
          {%- if section.settings.col2_menu.links.size > 0 -%}
          {%- for link in section.settings.col2_menu.links -%}
          <li><a href="{{ link.url }}">{{ link.title }}</a></li>
          {%- endfor -%}
          {%- else -%}
          <li><a href="{{ faq_url }}">الأسئلة الشائعة</a></li>
          <li><a href="{{ faq_url }}">السياسات</a></li>
          {%- endif -%}
        </ul>
      </div>
      <div>
        <h4>{{ section.settings.col3_heading }}</h4>
        <ul>
          {%- if section.settings.col3_menu.links.size > 0 -%}
          {%- for link in section.settings.col3_menu.links -%}
          <li><a href="{{ link.url }}">{{ link.title }}</a></li>
          {%- endfor -%}
          {%- else -%}
          <li><a href="{{ oud_collection.url | default: routes.all_products_collection_url }}">المباخر</a></li>
          <li><a href="{{ wedding_collection.url | default: routes.all_products_collection_url }}">ستاند عقد القران</a></li>
          {%- endif -%}
        </ul>
      </div>
      <div class="ftr-social">
        <h4>{{ section.settings.col4_heading }}</h4>
        <div class="social-links" aria-label="حسابات التواصل الاجتماعي">
          {%- if section.settings.instagram_url != blank -%}
          <a class="social-link" href="{{ section.settings.instagram_url }}" target="_blank" rel="noopener" aria-label="إنستغرام">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <rect x="3.5" y="3.5" width="17" height="17" rx="5"></rect>
              <circle cx="12" cy="12" r="4"></circle>
              <circle cx="17.4" cy="6.6" r="1"></circle>
            </svg>
          </a>
          {%- else -%}
          <span class="social-link social-link--disabled" aria-label="إنستغرام">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <rect x="3.5" y="3.5" width="17" height="17" rx="5"></rect>
              <circle cx="12" cy="12" r="4"></circle>
              <circle cx="17.4" cy="6.6" r="1"></circle>
            </svg>
          </span>
          {%- endif -%}
          {%- if section.settings.snapchat_url != blank -%}
          <a class="social-link" href="{{ section.settings.snapchat_url }}" target="_blank" rel="noopener" aria-label="سناب شات">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M12 3.7c-3.2 0-5.4 2.3-5.4 5.5v2.4c0 .8-.3 1.4-1.1 1.9-.4.3-.2.9.3 1l2.1.4c.3 1.1 1.2 2 2.3 2.4.3 1 1.1 1.7 1.8 1.7s1.5-.7 1.8-1.7c1.1-.4 2-1.3 2.3-2.4l2.1-.4c.5-.1.7-.7.3-1-.8-.5-1.1-1.1-1.1-1.9V9.2c0-3.2-2.2-5.5-5.4-5.5Z"></path>
            </svg>
          </a>
          {%- else -%}
          <span class="social-link social-link--disabled" aria-label="سناب شات">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M12 3.7c-3.2 0-5.4 2.3-5.4 5.5v2.4c0 .8-.3 1.4-1.1 1.9-.4.3-.2.9.3 1l2.1.4c.3 1.1 1.2 2 2.3 2.4.3 1 1.1 1.7 1.8 1.7s1.5-.7 1.8-1.7c1.1-.4 2-1.3 2.3-2.4l2.1-.4c.5-.1.7-.7.3-1-.8-.5-1.1-1.1-1.1-1.9V9.2c0-3.2-2.2-5.5-5.4-5.5Z"></path>
            </svg>
          </span>
          {%- endif -%}
          {%- if section.settings.tiktok_url != blank -%}
          <a class="social-link" href="{{ section.settings.tiktok_url }}" target="_blank" rel="noopener" aria-label="تيك توك">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M14.4 4v9.2a3.7 3.7 0 1 1-3.7-3.7c.4 0 .8.1 1.2.2v2.2a1.7 1.7 0 1 0 .5 1.3V4h2Z"></path>
              <path d="M14.4 4c.4 1.8 1.6 3 3.6 3.4v2.1c-1.4-.2-2.6-.8-3.6-1.7"></path>
            </svg>
          </a>
          {%- else -%}
          <span class="social-link social-link--disabled" aria-label="تيك توك">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M14.4 4v9.2a3.7 3.7 0 1 1-3.7-3.7c.4 0 .8.1 1.2.2v2.2a1.7 1.7 0 1 0 .5 1.3V4h2Z"></path>
              <path d="M14.4 4c.4 1.8 1.6 3 3.6 3.4v2.1c-1.4-.2-2.6-.8-3.6-1.7"></path>
            </svg>
          </span>
          {%- endif -%}
        </div>
      </div>
    </div>
    <div class="ftr-bottom">
      {%- assign ftr_year = 'now' | date: '%Y' -%}
      <span>© {% render 'arabic-digits', value: ftr_year %} {{ section.settings.copyright_name }}</span>
      <nav>
        <a href="{{ about_url }}">من نحن</a>
        <a href="{{ contact_url }}">تواصل معنا</a>
        <a href="{{ faq_url }}">الأسئلة الشائعة</a>
        <a href="{{ faq_url }}">السياسات</a>
      </nav>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "الفوتر",
  "settings": [
    {
      "type": "text",
      "id": "signup_heading",
      "label": "عنوان تسجيل البريد",
      "default": "تسجيل البريد"
    },
    {
      "type": "text",
      "id": "signup_text",
      "label": "نص تسجيل البريد",
      "default": "اشترك ليصلك جديد كالابريز وإطلاق ستاند عقد القران."
    },
    {
      "type": "text",
      "id": "col1_heading",
      "label": "عنوان العمود الأول",
      "default": "كالابريز"
    },
    {
      "type": "link_list",
      "id": "col1_menu",
      "label": "قائمة العمود الأول"
    },
    {
      "type": "text",
      "id": "col2_heading",
      "label": "عنوان العمود الثاني",
      "default": "المساعدة"
    },
    {
      "type": "link_list",
      "id": "col2_menu",
      "label": "قائمة العمود الثاني"
    },
    {
      "type": "text",
      "id": "col3_heading",
      "label": "عنوان العمود الثالث",
      "default": "المتجر"
    },
    {
      "type": "link_list",
      "id": "col3_menu",
      "label": "قائمة العمود الثالث"
    },
    {
      "type": "text",
      "id": "col4_heading",
      "label": "عنوان عمود التواصل",
      "default": "تابعنا"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "رابط إنستغرام"
    },
    {
      "type": "url",
      "id": "snapchat_url",
      "label": "رابط سناب شات"
    },
    {
      "type": "url",
      "id": "tiktok_url",
      "label": "رابط تيك توك"
    },
    {
      "type": "text",
      "id": "copyright_name",
      "label": "اسم حقوق النشر",
      "default": "كالابريز"
    }
  ]
}
{% endschema %}
