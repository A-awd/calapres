{%- assign menu = section.settings.menu -%}
<header class="hdr">
  <div class="wrap hdr-top">
    <div class="hdr-actions hdr-actions--left">
      <a class="icon-button" href="{{ routes.account_url }}" aria-label="حسابي" title="حسابي">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <circle cx="12" cy="8" r="3.25"></circle>
          <path d="M4.5 20c.7-3.75 3.2-5.75 7.5-5.75s6.8 2 7.5 5.75"></path>
        </svg>
      </a>
      <button class="icon-button cart-link" id="cartOpen" type="button" aria-label="سلّتي" title="سلّتي">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="M3.5 5h2l1.55 8.1a2 2 0 0 0 2 1.62h6.8a2 2 0 0 0 1.94-1.52L19 8H7"></path>
          <circle cx="9.2" cy="19" r="1.15"></circle>
          <circle cx="17.1" cy="19" r="1.15"></circle>
        </svg>
        <span class="cart-count" id="cartCount">{% render 'arabic-digits', value: cart.item_count %}</span>
      </button>
    </div>
    <a class="logo logo--wordmark" href="{{ routes.root_url }}" aria-label="{{ section.settings.logo_text | escape }}">
      <img
        class="logo__wordmark"
        src="{{ 'calapres-wordmark.png' | asset_url }}"
        alt=""
        width="1249"
        height="220"
        fetchpriority="high"
      >
    </a>
    <div class="hdr-actions hdr-actions--right">
      <button class="burger" id="menuOpen" type="button" aria-label="فتح قائمة المتجر" aria-controls="mnav" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
  <div class="wrap hdr-nav-row">
    <nav class="hdr-nav">
      {%- if menu.links.size > 0 -%}
      {%- for link in menu.links -%}
      <a href="{{ link.url }}">{{ link.title }}</a>
      {%- endfor -%}
      {%- else -%}
      <a href="{{ routes.all_products_collection_url }}">المتجر</a>
      {%- endif -%}
    </nav>
  </div>
  <nav class="mnav" id="mnav">
    {%- if menu.links.size > 0 -%}
    {%- for link in menu.links -%}
    <a href="{{ link.url }}">{{ link.title }}</a>
    {%- endfor -%}
    {%- else -%}
    <a href="{{ routes.all_products_collection_url }}">المتجر</a>
    {%- endif -%}
  </nav>
</header>

{% schema %}
{
  "name": "الهيدر",
  "settings": [
    {
      "type": "text",
      "id": "logo_text",
      "label": "اسم الشعار لقارئات الشاشة",
      "default": "كالابريز"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "القائمة الرئيسية",
      "default": "main-menu"
    },
    {
      "type": "text",
      "id": "support_label",
      "label": "نص رابط خدمة العملاء",
      "default": "خدمة العملاء"
    },
    {
      "type": "url",
      "id": "support_link",
      "label": "رابط خدمة العملاء"
    }
  ]
}
{% endschema %}
