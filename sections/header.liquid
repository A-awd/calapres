{%- comment -%}
  Header (.hdr) ported 1:1 from the static prototype.
  Nav links come from a Shopify menu (default: main-menu);
  the account link uses the real account route and the cart
  badge is server-rendered then kept live by calabriz-cart.js.
{%- endcomment -%}
{%- assign menu = section.settings.menu -%}
{%- assign support_url = section.settings.support_link | default: pages['contact'].url | default: routes.root_url -%}
<header class="hdr">
  <div class="wrap hdr-top">
    <div class="util">
      <a href="{{ support_url }}">{{ section.settings.support_label }}</a>
    </div>
    <a class="logo" href="{{ routes.root_url }}">{{ section.settings.logo_text }}</a>
    <div class="meta">
      <a href="{{ routes.account_url }}">حسابي</a>
      <button class="cart-link" id="cartOpen">سلّتي <span class="cart-count" id="cartCount">{% render 'arabic-digits', value: cart.item_count %}</span></button>
      <button class="burger" id="menuOpen" aria-label="القائمة"><span></span><span></span><span></span></button>
    </div>
  </div>
  <div class="wrap hdr-nav-row">
    <nav class="hdr-nav">
      {%- if menu.links.size > 0 -%}
      {%- for link in menu.links -%}
      <a href="{{ link.url }}">{{ link.title }}</a>
      {%- endfor -%}
      {%- else -%}
      <a href="{{ routes.all_products_collection_url }}">المتجر</a>
      {%- endif -%}
    </nav>
  </div>
  <nav class="mnav" id="mnav">
    {%- if menu.links.size > 0 -%}
    {%- for link in menu.links -%}
    <a href="{{ link.url }}">{{ link.title }}</a>
    {%- endfor -%}
    {%- else -%}
    <a href="{{ routes.all_products_collection_url }}">المتجر</a>
    {%- endif -%}
  </nav>
</header>

{% schema %}
{
  "name": "الهيدر",
  "settings": [
    {
      "type": "text",
      "id": "logo_text",
      "label": "نص الشعار",
      "default": "كالابريز"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "القائمة الرئيسية",
      "default": "main-menu"
    },
    {
      "type": "text",
      "id": "support_label",
      "label": "نص رابط خدمة العملاء",
      "default": "خدمة العملاء"
    },
    {
      "type": "url",
      "id": "support_link",
      "label": "رابط خدمة العملاء"
    }
  ]
}
{% endschema %}
