<section class="page-head">
  <div class="wrap">
    <h1>{{ blog.title }}</h1>
  </div>
</section>
<section class="products">
  <div class="wrap">
    {%- paginate blog.articles by 12 -%}
    <div class="prod-grid">
      {%- for article in blog.articles -%}
      <a class="pcard" href="{{ article.url }}">
        {%- if article.image -%}
        <div class="ph"><img src="{{ article.image | image_url: width: 900 }}" alt="{{ article.image.alt | default: article.title | escape }}" loading="lazy" width="{{ article.image.width }}" height="{{ article.image.height }}"></div>
        {%- endif -%}
        <div class="pbody">
          <h3>{{ article.title }}</h3>
          {%- assign blog_date = article.published_at | date: '%Y/%m/%d' -%}
          <div class="color">{% render 'arabic-digits', value: blog_date %}</div>
        </div>
      </a>
      {%- else -%}
      <p class="form-note">لا توجد مقالات بعد.</p>
      {%- endfor -%}
    </div>
    {%- if paginate.pages > 1 -%}
    <div class="sec-head" style="margin-top:2rem">
      {%- if paginate.previous -%}<a class="link-arrow" href="{{ paginate.previous.url }}">السابق</a>{%- endif -%}
      {%- if paginate.next -%}<a class="link-arrow" href="{{ paginate.next.url }}">التالي</a>{%- endif -%}
    </div>
    {%- endif -%}
    {%- endpaginate -%}
  </div>
</section>
