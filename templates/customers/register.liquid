<section class="page-intro">
  <div class="wrap">
    <h1>إنشاء حساب</h1>
  </div>
</section>
<section class="wrap contact-grid" style="padding-bottom:clamp(3.5rem,7vw,5.5rem)">
  <div class="form-card">
    {% form 'create_customer' %}
      {%- if form.errors -%}
      <p class="form-note err">تعذّر إنشاء الحساب — تحقق من البيانات وحاول مرة أخرى.</p>
      {%- endif -%}
      <div class="field">
        <label for="regFirst">الاسم الأول</label>
        <input type="text" id="regFirst" name="customer[first_name]" autocomplete="given-name">
      </div>
      <div class="field">
        <label for="regLast">اسم العائلة</label>
        <input type="text" id="regLast" name="customer[last_name]" autocomplete="family-name">
      </div>
      <div class="field">
        <label for="regEmail">البريد الإلكتروني</label>
        <input type="email" id="regEmail" name="customer[email]" required autocomplete="email">
      </div>
      <div class="field">
        <label for="regPassword">كلمة المرور</label>
        <input type="password" id="regPassword" name="customer[password]" required autocomplete="new-password">
      </div>
      <button class="btn-dark" type="submit">إنشاء الحساب</button>
    {% endform %}
  </div>
  <aside class="side-card">
    <h2>لديك حساب؟</h2>
    <ul>
      <li><a class="link-arrow" href="{{ routes.account_login_url }}">تسجيل الدخول <span>←</span></a></li>
    </ul>
  </aside>
</section>
