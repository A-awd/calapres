<section class="page-intro">
  <div class="wrap">
    <h1>إعادة تعيين كلمة المرور</h1>
    <p>أدخل كلمة مرور جديدة لحسابك.</p>
  </div>
</section>
<section class="wrap page-content">
  <div class="form-card" style="max-width:560px">
    {% form 'reset_customer_password' %}
      {%- if form.errors -%}
      <p class="form-note err">تعذّرت إعادة التعيين — تحقق من كلمة المرور وحاول مرة أخرى.</p>
      {%- endif -%}
      <div class="field">
        <label for="rstPassword">كلمة المرور الجديدة</label>
        <input type="password" id="rstPassword" name="customer[password]" required autocomplete="new-password">
      </div>
      <div class="field">
        <label for="rstConfirm">تأكيد كلمة المرور</label>
        <input type="password" id="rstConfirm" name="customer[password_confirmation]" required autocomplete="new-password">
      </div>
      <button class="btn-dark" type="submit">حفظ كلمة المرور</button>
    {% endform %}
  </div>
</section>
