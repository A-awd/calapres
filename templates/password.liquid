<main class="nf">
  <p class="hero-eyebrow">{{ settings.brand_name | default: shop.name }}</p>
  <p class="nf-msg">المتجر تحت التجهيز — عُد إلينا قريبًا.</p>
  {% form 'storefront_password', class: 'notify-form pw-form' %}
    {%- if form.errors -%}
    <p class="form-note err">كلمة المرور غير صحيحة.</p>
    {%- endif -%}
    <input type="password" name="password" required placeholder="كلمة المرور" aria-label="كلمة المرور">
    <button type="submit">دخول</button>
  {% endform %}
</main>
