{%- comment -%}
  Renders a number/string with Western digits converted to
  Arabic-Indic digits, e.g. 390 -> ٣٩٠.
  Usage: {% render 'arabic-digits', value: cart.item_count %}
{%- endcomment -%}
{{- value | append: '' | replace: '0', '٠' | replace: '1', '١' | replace: '2', '٢' | replace: '3', '٣' | replace: '4', '٤' | replace: '5', '٥' | replace: '6', '٦' | replace: '7', '٧' | replace: '8', '٨' | replace: '9', '٩' -}}