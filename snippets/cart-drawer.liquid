{%- comment -%}
  Cart drawer + scrim + toast (markup ported 1:1 from the
  static prototype). Contents are rendered client-side by
  calabriz-cart.js from the Shopify AJAX Cart API.
{%- endcomment -%}
<style>
  .national-address-help {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: .25rem;
    margin: .75rem 0;
    padding: .7rem .6rem;
    width: 100%;
    box-sizing: border-box;
    border: 1px solid rgba(var(--ink-rgb), .55);
    background: rgba(var(--ink-rgb), .14);
    color: var(--midnight);
    font-size: .84rem;
    line-height: 1.4;
    text-align: center;
    text-decoration: none;
    transition: background .2s ease, border-color .2s ease;
  }
  .national-address-help__message {
    font-size: .88rem;
    font-weight: 700;
  }
  .national-address-help__action {
    font-size: .8rem;
  }
  .national-address-help strong {
    color: inherit;
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: .18em;
  }
  .national-address-help:hover {
    border-color: var(--gold);
    background: rgba(var(--ink-rgb), .18);
  }
  .national-address-help:focus-visible {
    outline: 2px solid var(--midnight);
    outline-offset: 2px;
  }
  .cart-page .national-address-help {
    margin: .75rem 0;
  }
  @media (max-width: 640px) {
    .national-address-help {
      gap: .2rem;
      padding: .62rem .35rem;
    }
    .national-address-help__message {
      font-size: clamp(.72rem, 3.2vw, .8rem);
      white-space: normal;
    }
    .national-address-help__action {
      font-size: clamp(.68rem, 3vw, .74rem);
      white-space: normal;
    }
  }
</style>
<div class="scrim" id="scrim"></div>
<aside class="drawer" id="drawer" aria-label="سلّة التسوق" data-shop-url="{{ routes.all_products_collection_url }}">
  <div class="d-head">
    <h3>سلّة التسوّق</h3>
    <button class="d-close" id="cartClose" aria-label="إغلاق">✕</button>
  </div>
  <div class="d-body" id="cartBody"></div>
  <div class="d-foot" id="cartFoot" style="display:none">
    <div class="d-total"><span>الإجمالي</span><b id="cartTotal">٠ ر.س</b></div>
    <a
      class="national-address-help"
      href="https://wa.me/966112898888?text=%D8%A7%D9%84%D8%B9%D9%86%D9%88%D8%A7%D9%86%20%D8%A7%D9%84%D9%88%D8%B7%D9%86%D9%8A"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="معرفة العنوان الوطني المختصر عبر واتساب سبل"
    >
      <span class="national-address-help__message">لتسهيل شحنتك، أضف عنوانك المختصر في صفحة الدفع.</span>
      <strong class="national-address-help__action">لا تعرف عنوانك المختصر؟ اعرفه عبر واتساب سبل ↗</strong>
    </a>
    <a class="btn-dark" id="checkoutBtn" href="/checkout">إتمام الطلب</a>
  </div>
</aside>
<div class="toast" id="toast"></div>
