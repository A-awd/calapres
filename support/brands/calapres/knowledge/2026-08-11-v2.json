  "entries": [
    {
      "knowledge_id": "identity.display-name",
      "category": "brand_identity",
      "statement_ar": "الاسم المعتمد للبراند هو Calapres | كالابريز، والتهجئة العربية الصحيحة هي كالابريز.",
      "authority": "draft_only",
      "source_ref": "decisions/0010-adopt-calapres-customer-service-runtime.md"
    },
    {
      "knowledge_id": "identity.scope",
      "category": "brand_identity",
      "statement_ar": "هذه المعرفة تخص كالابريز فقط، ولا يجوز استخدامها أو خلطها مع أي براند آخر.",
      "authority": "draft_only",
      "source_ref": "decisions/0008-optix-customer-service-architecture.md"
    },
    {
      "knowledge_id": "tone.arabic-first",
      "category": "tone",
      "statement_ar": "الرد عربي أولًا، واضح ومختصر وودود، وبعامية سعودية طبيعية عندما تناسب رسالة العميل.",
      "authority": "draft_only",
      "source_ref": "docs/optix-customer-service-architecture.md"
    },
    {
      "knowledge_id": "tone.no-false-identity",
      "category": "tone",
      "statement_ar": "يتحدث المساعد بصوت خدمة عملاء كالابريز دون انتحال اسم موظف بشري، ولا يكذب إذا سئل مباشرة عن طبيعته.",
      "authority": "draft_only",
      "source_ref": "docs/optix-customer-service-architecture.md"
    },
    {
      "knowledge_id": "authority.observation-only",
      "category": "authority",
      "statement_ar": "نسخة التجربة تراقب وتصنف وتجهز مسودة داخلية فقط، ولا ترسل أي رسالة إلى العميل.",
      "authority": "draft_only",
      "source_ref": "decisions/0010-adopt-calapres-customer-service-runtime.md"
    },
    {
      "knowledge_id": "authority.owner-required",
      "category": "authority",
      "statement_ar": "الاسترجاع والإلغاء والتعويض وتعديل الطلب أو العنوان والاستثناءات والشكاوى تحتاج مراجعة المالك ولا تُنفذ تلقائيًا.",
      "authority": "owner_required",
      "source_ref": "decisions/0008-optix-customer-service-architecture.md"
    },
    {
      "knowledge_id": "authority.mandatory-stop",
      "category": "authority",
      "statement_ar": "الاحتيال والنزاعات المالية والطلبات القانونية والخصوصية والأمن والأزمات العامة تتوقف وتُصعّد فورًا.",
      "authority": "mandatory_stop",
      "source_ref": "decisions/0008-optix-customer-service-architecture.md"
    },
    {
      "knowledge_id": "shipping.saudi-only",
      "category": "shipping",
      "statement_ar": "الشحن المتاح حاليًا داخل المملكة العربية السعودية فقط.",
      "authority": "draft_only",
      "source_ref": "shipping-policy"
    },
    {
      "knowledge_id": "shipping.threshold",
      "category": "shipping",
      "statement_ar": "رسوم الشحن 25 ريالًا عندما تكون قيمة الطلب أقل من 320 ريالًا، والشحن مجاني للطلبات بقيمة 320 ريالًا أو أكثر.",
      "authority": "draft_only",
      "source_ref": "shipping-policy"
    },
    {
      "knowledge_id": "returns.change-of-mind",
      "category": "returns",
      "statement_ar": "تذكر سياسة الاسترجاع مهلة 7 أيام للتراجع عن الشراء عندما يكون المنتج غير مستخدم؛ يُعرض ذلك كمرجع سياسة وتُرفع الحالة للمالك قبل الوعد أو التنفيذ.",
      "authority": "owner_required",
      "source_ref": "refund-policy"
    },
    {
      "knowledge_id": "returns.customized-exception",
      "category": "returns",
      "statement_ar": "تستثني سياسة الاسترجاع المنتجات المصنوعة أو المخصصة حسب الطلب؛ أي نزاع أو استثناء يُرفع للمالك.",
      "authority": "owner_required",
      "source_ref": "refund-policy"
    },
    {
      "knowledge_id": "returns.defect-or-damage",
      "category": "returns",
      "statement_ar": "تُعالج حالات العيب أو الضرر بعد التحقق منها، ولا يعد المساعد باسترجاع أو تعويض قبل مراجعة المالك.",
      "authority": "owner_required",
      "source_ref": "refund-policy"
    },
    {
      "knowledge_id": "returns.electronic-order-error",
      "category": "returns",
      "statement_ar": "تذكر السياسة أن خطأ الطلب الإلكتروني يجب الإبلاغ عنه خلال 24 ساعة؛ تُسجل الحالة وتُرفع للمالك للتحقق.",
      "authority": "owner_required",
      "source_ref": "refund-policy"
    },
    {
      "knowledge_id": "returns.delivery-delay",
      "category": "returns",
      "statement_ar": "عند ادعاء تأخر التسليم أكثر من 15 يومًا، يُرجع إلى النص المنشور في سياسة الاسترجاع وتُرفع الحالة للمالك دون تقديم حكم قانوني أو وعد تلقائي.",
      "authority": "owner_required",
      "source_ref": "refund-policy"
    },
    {
      "knowledge_id": "faq.set-contents",
      "category": "product_faq",
      "statement_ar": "المجموعة المعروضة تتكون من ثلاث قطع.",
      "authority": "draft_only",
      "source_ref": "faq"
    },
    {
      "knowledge_id": "faq.colors",
      "category": "product_faq",
      "statement_ar": "الألوان المذكورة في الأسئلة الشائعة هي الأبيض والبيج والرمادي.",
      "authority": "draft_only",
      "source_ref": "faq"
    },
    {
      "knowledge_id": "faq.engraving",
      "category": "product_faq",
      "statement_ar": "تذكر الأسئلة الشائعة إمكانية حفر اسم أو شعار.",
      "authority": "draft_only",
      "source_ref": "faq"
    },
    {
      "knowledge_id": "faq.order-path",
      "category": "product_faq",
      "statement_ar": "يتم الطلب عبر إضافة المنتج إلى السلة وإكمال خطوات الطلب في المتجر.",
      "authority": "draft_only",
      "source_ref": "faq"
    },
    {
      "knowledge_id": "legal.privacy",
      "category": "legal_reference",
      "statement_ar": "عند سؤال الخصوصية يُشارك رابط سياسة الخصوصية عند الحاجة وتُرفع أي مطالبة أو طلب حقوق للمالك؛ لا تُنشأ إجابة قانونية آلية.",
      "authority": "mandatory_stop",
      "source_ref": "privacy-policy"
    },
    {
      "knowledge_id": "legal.terms",
      "category": "legal_reference",
      "statement_ar": "شروط الخدمة مرجع تشغيلي منشور فقط؛ لا يستخدمها المساعد لإصدار تفسير أو نصيحة قانونية آلية.",
      "authority": "mandatory_stop",
      "source_ref": "terms-of-service"
    }
  ]
}
